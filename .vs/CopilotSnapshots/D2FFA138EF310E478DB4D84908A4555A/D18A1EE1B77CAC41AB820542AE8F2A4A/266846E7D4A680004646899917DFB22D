@{
    ViewBag.Title = "Trang chủ - TechWorld";
}

<style>
    /* 1. Animation chạy tin tức chui vào chữ HOT */
    @@keyframes scroll-left {
        0% {
            transform: translateX(100%);
        }

        100% {
            transform: translateX(-120%);
        }
    }

    .news-ticker-container {
        position: relative;
        background: #e6fffa;
        border: 1px solid #b2f5ea;
        color: #234e52;
        padding: 10px;
        border-radius: 8px;
        overflow: hidden;
        display: flex;
        align-items: center;
        height: 45px;
    }

    .ticker-label {
        position: relative;
        font-weight: bold;
        color: #fff;
        background: #38a169;
        padding: 5px 15px;
        border-radius: 5px;
        margin-right: 10px;
        z-index: 10;
        box-shadow: 2px 0 5px rgba(0,0,0,0.1);
    }

    .ticker-content-wrapper {
        flex: 1;
        overflow: hidden;
        position: relative;
        z-index: 5;
    }

    .ticker-content {
        display: inline-block;
        white-space: nowrap;
        animation: scroll-left 25s linear infinite;
    }

        .ticker-content:hover {
            animation-play-state: paused;
        }

        .ticker-content a {
            color: #2c7a7b !important;
            text-decoration: none;
            margin-right: 100px;
            font-weight: 500;
        }

    /* 2. Style Card Sản Phẩm & Banner */
    .custom-caption {
        background: rgba(0, 0, 0, 0.5);
        backdrop-filter: blur(8px);
        border-radius: 15px;
        padding: 20px;
        bottom: 15%;
        z-index: 20;
    }

    .product-card {
        transition: all 0.3s ease;
        border-radius: 10px;
        overflow: hidden;
        border: 1px solid #eee;
        background: #fff;
        height: 100%;
    }

        .product-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.1);
        }
</style>

<div class="row mt-3">
    <div class="col-12 mb-4">
        <div id="carouselBanner" class="carousel slide carousel-fade" data-bs-ride="carousel" data-bs-interval="3000">
            <div class="carousel-indicators">
                <button type="button" data-bs-target="#carouselBanner" data-bs-slide-to="0" class="active"></button>
                <button type="button" data-bs-target="#carouselBanner" data-bs-slide-to="1"></button>
            </div>
            <div class="carousel-inner" style="border-radius: 15px; overflow: hidden; box-shadow: 0 8px 25px rgba(0,0,0,0.2);">
                <div class="carousel-item active" data-bs-interval="3000">
                    <a href="@Url.Action("Index", "Product")">
                        <img src="~/Content/Images/Tech1.png" class="d-block w-100" style="height: 350px; object-fit: cover;">
                        <div class="carousel-caption d-none d-md-block custom-caption">
                            <h2 style="font-weight: bold; color: #a2f6a2;">Khuyến mãi lớn 50%</h2>
                            <p>Tất cả sản phẩm điện tử tại TechWorld</p>
                        </div>
                    </a>
                </div>
                <div class="carousel-item" data-bs-interval="3000">
                    <a href="@Url.Action("Index", "Product", new { categoryId = 2 })">
                        <img src="~/Content/Images/Tech2.png" class="d-block w-100" style="height: 350px; object-fit: cover;">
                        <div class="carousel-caption d-none d-md-block custom-caption">
                            <h2 style="font-weight: bold; color: #a2f6a2;">Laptop thế hệ mới</h2>
                            <p>Giá cạnh tranh, chất lượng đỉnh cao</p>
                        </div>
                    </a>
                </div>
            </div>
            <button class="carousel-control-prev" type="button" data-bs-target="#carouselBanner" data-bs-slide="prev" style="z-index: 30;">
                <span class="carousel-control-prev-icon"></span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#carouselBanner" data-bs-slide="next" style="z-index: 30;">
                <span class="carousel-control-next-icon"></span>
            </button>
        </div>
    </div>
</div>

<div class="row mb-4">
    <div class="col-12">
        <div class="news-ticker-container">
            <div class="ticker-label"><i class="fas fa-bolt"></i> HOT</div>
            <div class="ticker-content-wrapper">
                <div class="ticker-content">
                    @if (ViewBag.LatestNews != null)
                    {
                        foreach (var news in ViewBag.LatestNews)
                        {
                            <a href="@Url.Action("Details", "News", new { id = news.Id })"> • @news.Title</a>
                        }
                    }
                    else
                    {
                        <span style="color: #2c7a7b;">Chào mừng bạn đến với TechWorld!</span>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row mt-4 mb-4">
    <div class="col-12">
        <h2 style="margin-bottom: 25px; font-weight: bold; color: #333;">
            <i class="fas fa-fire" style="color: #ff4757;"></i> Sản phẩm nổi bật
        </h2>
    </div>

    @if (ViewBag.HotProducts != null)
    {
        foreach (var product in ViewBag.HotProducts)
        {
            <div class="col-lg-2 col-md-3 col-sm-6 mb-4">
                <div class="product-card p-2 text-center">
                    <div style="position: relative;">
                        <img src="@Url.Content(product.ImageUrl)" alt="@product.Name" style="width: 100%; height: 160px; object-fit: contain;">
                        <span style="position: absolute; top: 5px; right: 5px; background: #ff4757; color: white; padding: 2px 8px; border-radius: 20px; font-size: 0.7rem; font-weight: bold;">HOT</span>
                    </div>
                    <div class="mt-2">
                        <div style="font-size: 0.9rem; font-weight: bold; height: 40px; overflow: hidden;">@product.Name</div>
                        <div style="color: #38a169; font-weight: bold; margin: 5px 0;">@product.Price.ToString("N0") ₫</div>
                        <div style="font-size: 0.8rem; color: #777;">Tồn kho: @product.Stock</div>
                        <button class="btn btn-primary btn-sm w-100 mt-2" onclick="addToCart(@product.Id)">
                            <i class="fas fa-shopping-cart"></i> Thêm giỏ
                        </button>
                    </div>
                </div>
            </div>
        }
    }
</div>

<div class="row mt-2 mb-5">
    <div class="col-12">
        <h2 style="margin-bottom: 20px; font-weight: bold;">Danh mục sản phẩm</h2>
    </div>
    @if (ViewBag.Categories != null)
    {
        foreach (var category in ViewBag.Categories)
        {
            <div class="col-lg-2 col-md-3 col-sm-4 mb-3">
                <a href="@Url.Action("Index", "Product", new { categoryId = category.Id })" style="text-decoration: none;">
                    <div style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; padding: 20px; border-radius: 12px; text-align: center; transition: all 0.3s;"
                         onmouseover="this.style.transform='translateY(-5px)'" onmouseout="this.style.transform='translateY(0)'">
                        <h6 style="margin: 0; font-weight: bold;">@category.Name</h6>
                    </div>
                </a>
            </div>
        }
    }
</div>

<!-- Community Section -->
<div class="row mt-5 mb-5">
    <div class="col-12">
        <div style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); border-radius: 20px; padding: 40px; color: white; text-align: center; box-shadow: 0 8px 25px rgba(102, 126, 234, 0.3);">
            <h2 style="font-weight: bold; margin-bottom: 15px;">
                <i class="fas fa-comments"></i> Tham Gia Cộng Đồng TechWorld
            </h2>
            <p style="font-size: 1.1rem; margin-bottom: 25px; opacity: 0.95;">
                Chia sẻ đánh giá sản phẩm, trao đổi kiến thức công nghệ, và kết nối với những người đam mê tech!
            </p>
            <div style="display: flex; gap: 15px; justify-content: center; flex-wrap: wrap;">
                <a href="@Url.Action("Index", "Home", new { area = "Community" })" 
                   style="background: white; color: #667eea; padding: 12px 30px; border-radius: 25px; text-decoration: none; font-weight: bold; transition: all 0.3s;"
                   onmouseover="this.style.transform='translateY(-2px)'" onmouseout="this.style.transform='translateY(0)'">
                    <i class="fas fa-eye"></i> Xem Cộng Đồng
                </a>
                @if (Session["UserId"] != null)
                {
                    <a href="@Url.Action("Create", "Post", new { area = "Community", type = 0 })" 
                       style="background: rgba(255,255,255,0.2); color: white; padding: 12px 30px; border-radius: 25px; text-decoration: none; font-weight: bold; border: 2px solid white; transition: all 0.3s;"
                       onmouseover="this.style.background='white'; this.style.color='#667eea';" onmouseout="this.style.background='rgba(255,255,255,0.2)'; this.style.color='white';">
                        <i class="fas fa-pen-fancy"></i> Đăng Bài Đánh Giá
                    </a>
                }
                else
                {
                    <a href="@Url.Action("Login", "Account")" 
                       style="background: rgba(255,255,255,0.2); color: white; padding: 12px 30px; border-radius: 25px; text-decoration: none; font-weight: bold; border: 2px solid white; transition: all 0.3s;"
                       onmouseover="this.style.background='white'; this.style.color='#667eea';" onmouseout="this.style.background='rgba(255,255,255,0.2)'; this.style.color='white';">
                        <i class="fas fa-sign-in-alt"></i> Đăng Nhập Để Đăng Bài
                    </a>
                }
            </div>
        </div>
    </div>
</div>

<!-- Showcase Section -->
<div class="row mt-5 mb-5">
    <div class="col-12">
        <h2 style="margin-bottom: 25px; font-weight: bold; color: #333;">
            <i class="fas fa-cube" style="color: #667eea;"></i> Trưng Bày Sản Phẩm
        </h2>
    </div>

    <div class="col-12">
        <div style="background: white; border-radius: 15px; padding: 30px; box-shadow: 0 5px 15px rgba(0,0,0,0.08);">
            <div class="row align-items-center">
                <div class="col-lg-6">
                    <h3 style="color: #222; margin-bottom: 15px; font-weight: 600;">
                        Khám Phá Chi Tiết Kỹ Thuật
                    </h3>
                    <p style="color: #666; font-size: 1.05rem; line-height: 1.8; margin-bottom: 20px;">
                        Xem chi tiết 3D interactive của các thiết bị công nghệ hàng đầu. 
                        Tìm hiểu về hệ thống camera, chip xử lý, pin, màn hình và hơn thế nữa 
                        thông qua giao diện trực quan.
                    </p>
                    <ul style="color: #555; margin-bottom: 25px;">
                        <li style="margin: 10px 0;"><i class="fas fa-check-circle" style="color: #38a169; margin-right: 8px;"></i> Xem 3D interactive từng linh kiện</li>
                        <li style="margin: 10px 0;"><i class="fas fa-check-circle" style="color: #38a169; margin-right: 8px;"></i> Chi tiết specs kỹ thuật đầy đủ</li>
                        <li style="margin: 10px 0;"><i class="fas fa-check-circle" style="color: #38a169; margin-right: 8px;"></i> So sánh hiệu năng các thành phần</li>
                        <li style="margin: 10px 0;"><i class="fas fa-check-circle" style="color: #38a169; margin-right: 8px;"></i> Hỗ trợ nhiều sản phẩm nổi bật</li>
                    </ul>
                    <a href="@Url.Action("Index", "Showcase")" 
                       style="display: inline-block; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; padding: 14px 35px; border-radius: 25px; text-decoration: none; font-weight: 600; font-size: 1.05rem; transition: all 0.3s; box-shadow: 0 4px 15px rgba(102, 126, 234, 0.3);"
                       onmouseover="this.style.transform='translateY(-2px)'; this.style.boxShadow='0 6px 20px rgba(102, 126, 234, 0.5)';" 
                       onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 4px 15px rgba(102, 126, 234, 0.3)';">
                        <i class="fas fa-arrow-right"></i> Vào Trưng Bày Ngay
                    </a>
                </div>
                <div class="col-lg-6" style="text-align: center;">
                    <div style="background: linear-gradient(135deg, #f0f4ff, #f5f0ff); border-radius: 15px; padding: 40px; position: relative; overflow: hidden;">
                        <div style="position: absolute; top: -50%; right: -10%; width: 400px; height: 400px; background: rgba(102, 126, 234, 0.1); border-radius: 50%; z-index: 0;"></div>
                        <div style="position: relative; z-index: 1;">
                            <i class="fas fa-mobile-alt" style="font-size: 120px; color: #667eea; opacity: 0.8;"></i>
                            <div style="margin-top: 20px; font-size: 16px; color: #555;">
                                <strong>Samsung Galaxy S24 Ultra</strong><br>
                                <small style="color: #999;">Click để xem 3D interactive</small>
                            </div>
                            <div style="margin-top: 30px; display: flex; gap: 15px; justify-content: center;">
                                <div style="text-align: center;">
                                    <div style="font-size: 24px; color: #667eea; font-weight: bold;">200MP</div>
                                    <small style="color: #999;">Camera</small>
                                </div>
                                <div style="text-align: center;">
                                    <div style="font-size: 24px; color: #667eea; font-weight: bold;">45W</div>
                                    <small style="color: #999;">Sạc nhanh</small>
                                </div>
                                <div style="text-align: center;">
                                    <div style="font-size: 24px; color: #667eea; font-weight: bold;">2600N</div>
                                    <small style="color: #999;">Độ sáng</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        var myCarousel = document.querySelector('#carouselBanner');
        var carousel = new bootstrap.Carousel(myCarousel, {
            interval: 3000,
            ride: 'carousel'
        });
    });
</script>