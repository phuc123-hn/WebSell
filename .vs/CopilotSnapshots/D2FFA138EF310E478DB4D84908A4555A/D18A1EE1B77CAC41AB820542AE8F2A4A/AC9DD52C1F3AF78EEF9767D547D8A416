<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Panel - TechWorld</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Be+Vietnam+Pro:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="@Url.Content("~/Content/theme.css")">

    <style>
        /* Admin Layout Specific */
        body {
            display: flex;
            min-height: 100vh;
        }

        .sidebar {
            height: 100vh;
            width: 260px;
            position: fixed;
            background: var(--bg-secondary);
            border-right: 1px solid var(--border-color);
            padding-top: 20px;
            overflow-y: auto;
            z-index: 1000;
        }

        .sidebar h4 {
            text-align: center;
            color: var(--color-primary);
            margin-bottom: 30px;
            font-weight: 700;
            letter-spacing: 1px;
            font-size: 16px;
        }

        .sidebar a {
            display: flex;
            align-items: center;
            gap: 12px;
            color: var(--text-secondary);
            padding: 12px 20px;
            text-decoration: none;
            font-weight: 500;
            font-size: 14px;
            transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
            margin: 4px 8px;
            border-radius: var(--border-radius-sm);
            border-left: 3px solid transparent;
        }

        .sidebar a:hover {
            background: rgba(124, 58, 237, 0.1);
            color: var(--color-primary);
            border-left-color: var(--color-primary);
            padding-left: 24px;
        }

        /* Active Menu Item */
        .sidebar a.active {
            background: rgba(124, 58, 237, 0.15);
            color: var(--color-primary);
            border-left-color: var(--color-primary);
        }

        .content {
            margin-left: 260px;
            padding: 30px;
            flex: 1;
            overflow-y: auto;
        }

        .topbar {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            padding: 16px 24px;
            border-radius: var(--border-radius-sm);
            margin-bottom: 24px;
            box-shadow: var(--shadow-md);
        }

        .topbar h5 {
            color: var(--text-primary);
            font-weight: 600;
            margin: 0;
        }

        .card {
            background: var(--bg-card) !important;
            border: 1px solid var(--border-color) !important;
            border-radius: var(--border-radius-sm);
            box-shadow: var(--shadow-md);
        }

        .card:hover {
            border-color: var(--border-color-hover) !important;
            box-shadow: var(--shadow-purple);
        }

        .card-header {
            background: linear-gradient(135deg, rgba(124, 58, 237, 0.1), rgba(6, 182, 212, 0.05)) !important;
            border-bottom: 1px solid var(--border-color) !important;
            color: var(--text-primary);
        }

        .form-label {
            color: var(--text-primary) !important;
            font-weight: 600;
            font-size: 14px;
            margin-bottom: 8px;
        }

        .form-check-label {
            color: var(--text-primary) !important;
            font-weight: 500;
        }

        /* Scrollbar */
        .sidebar::-webkit-scrollbar {
            width: 6px;
        }

        .sidebar::-webkit-scrollbar-track {
            background: var(--bg-primary);
        }

        .sidebar::-webkit-scrollbar-thumb {
            background: linear-gradient(135deg, var(--color-primary), var(--color-cyan));
            border-radius: 3px;
        }

        /* Responsive */
        @media (max-width: 768px) {
            .sidebar {
                width: 240px;
            }

            .content {
                margin-left: 240px;
                padding: 16px;
            }

            .topbar {
                padding: 12px 16px;
            }
        }

        @media (max-width: 576px) {
            .sidebar {
                position: fixed;
                width: 100%;
                height: auto;
                z-index: 1001;
                border-right: none;
                border-bottom: 1px solid var(--border-color);
            }

            .content {
                margin-left: 0;
                margin-top: 0;
            }

            .sidebar a {
                display: inline-block;
                padding: 10px 16px;
                margin: 0;
                border-radius: 0;
                border: none;
            }
        }
    </style>

    @RenderSection("Styles", false)
</head>

<body>

    <div class="sidebar">
        <h4><i class="fas fa-shield-alt"></i> ADMIN</h4>

        <a href="@Url.Action("Index","Home", new { area = "Admin" })" class="@(ViewContext.RouteData.Values["Controller"].ToString() == "Home" ? "active" : "")">
            <i class="fas fa-chart-line"></i> Dashboard
        </a>

        <a href="@Url.Action("Index","Product", new { area = "Admin" })" class="@(ViewContext.RouteData.Values["Controller"].ToString() == "Product" ? "active" : "")">
            <i class="fas fa-box"></i> Sản phẩm
        </a>

        <a href="@Url.Action("Index","News", new { area = "Admin" })" class="@(ViewContext.RouteData.Values["Controller"].ToString() == "News" ? "active" : "")">
            <i class="fas fa-newspaper"></i> Tin tức
        </a>

        <a href="@Url.Action("Index","Order", new { area = "Admin" })" class="@(ViewContext.RouteData.Values["Controller"].ToString() == "Order" ? "active" : "")">
            <i class="fas fa-shopping-cart"></i> Đơn hàng
        </a>

        <a href="@Url.Action("Index","User", new { area = "Admin" })" class="@(ViewContext.RouteData.Values["Controller"].ToString() == "User" ? "active" : "")">
            <i class="fas fa-users"></i> Người dùng
        </a>

        <a href="@Url.Action("Index","Voucher", new { area = "Admin" })" class="@(ViewContext.RouteData.Values["Controller"].ToString() == "Voucher" ? "active" : "")">
            <i class="fas fa-ticket-alt"></i> Voucher
        </a>

        <a href="@Url.Action("Index","Event", new { area = "Admin" })" class="@(ViewContext.RouteData.Values["Controller"].ToString() == "Event" ? "active" : "")">
            <i class="fas fa-calendar"></i> Sự kiện
        </a>

        <a href="@Url.Action("Index","LuckySpinPrize", new { area = "Admin" })" class="@(ViewContext.RouteData.Values["Controller"].ToString() == "LuckySpinPrize" ? "active" : "")">
            <i class="fas fa-gift"></i> Vòng quay
        </a>

        <hr style="border-color: var(--border-color); margin: 20px 0;">

        <a href="@Url.Action("Logout","Account", new { area="" })" style="color: var(--color-danger);">
            <i class="fas fa-sign-out-alt"></i> Đăng xuất
        </a>
    </div>

    <div class="content">
        <div class="topbar mb-4">
            <h5><i class="fas fa-crown" style="color: var(--color-primary);"></i> Admin Dashboard</h5>
        </div>

        @RenderBody()
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    @RenderSection("scripts", required: false)

</body>
</html>