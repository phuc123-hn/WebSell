using System;
using System.Net;
using System.Net.Mail;
using System.Configuration;
using System.Linq;
using web1.Infrastructure.Logging;

namespace web1.Services
{
    public interface IEmailService
    {
        bool SendOTP(string toEmail, string otp, string userName = "");
        bool SendPasswordResetLink(string toEmail, string resetLink, string userName = "");
        bool SendOrderConfirmation(string toEmail, int orderId, decimal totalAmount);
        bool SendGenericEmail(string toEmail, string subject, string htmlBody);
    }

    public class EmailService : IEmailService
    {
        private readonly FileLogger _logger = new FileLogger();
        private readonly string _smtpServer;
        private readonly int _smtpPort;
        private readonly string _smtpUsername;
        private readonly string _smtpPassword;
        private readonly string _senderEmail;
        private readonly string _senderName;

        public EmailService()
        {
            // Đọc từ Web.config - KHÔNG hard-code
            _smtpServer = ConfigurationManager.AppSettings["EmailSmtpServer"] ?? "smtp.gmail.com";
            _smtpPort = int.TryParse(ConfigurationManager.AppSettings["EmailSmtpPort"], out var port) ? port : 587;
            _smtpUsername = ConfigurationManager.AppSettings["EmailUsername"] ?? "";
            _smtpPassword = ConfigurationManager.AppSettings["EmailPassword"] ?? "";
            _senderEmail = ConfigurationManager.AppSettings["EmailSenderAddress"] ?? _smtpUsername;
            _senderName = ConfigurationManager.AppSettings["EmailSenderName"] ?? "TechWorld";

            ValidateConfiguration();
        }

        private void ValidateConfiguration()
        {
            _logger.LogInfo($"SMTP Config: server={_smtpServer}, port={_smtpPort}, user={_smtpUsername}, sender={_senderEmail}, passwordSet={!string.IsNullOrEmpty(_smtpPassword)}");
            
            if (string.IsNullOrEmpty(_smtpServer) || string.IsNullOrEmpty(_smtpUsername) || string.IsNullOrEmpty(_smtpPassword))
            {
                _logger.LogError("❌ SMTP configuration is INCOMPLETE! Check Web.config appSettings:");
                _logger.LogError($"   - EmailSmtpServer: {(string.IsNullOrEmpty(_smtpServer) ? "MISSING!" : _smtpServer)}");
                _logger.LogError($"   - EmailSmtpPort: {_smtpPort}");
                _logger.LogError($"   - EmailUsername: {(string.IsNullOrEmpty(_smtpUsername) ? "MISSING!" : _smtpUsername)}");
                _logger.LogError($"   - EmailPassword: {(string.IsNullOrEmpty(_smtpPassword) ? "MISSING!" : "***")}");
                _logger.LogError($"   - EmailSenderAddress: {(string.IsNullOrEmpty(_senderEmail) ? "MISSING!" : _senderEmail)}");
                _logger.LogError($"   - EmailSenderName: {(string.IsNullOrEmpty(_senderName) ? "MISSING!" : _senderName)}");
            }
            else
            {
                _logger.LogInfo("✅ SMTP configuration is COMPLETE and ready to use.");
            }
        }

        public bool SendOTP(string toEmail, string otp, string userName = "")
        {
            try
            {
                // Send directly to email address provided (no DB lookup needed)
                if (string.IsNullOrEmpty(toEmail))
                {
                    _logger.LogError("SendOTP: Email address is empty!");
                    return false;
                }

                string subject = "🔐 Mã xác thực TechWorld - OTP";
                string htmlBody = GenerateOTPEmailTemplate(otp, userName);

                return SendGenericEmail(toEmail, subject, htmlBody);
            }
            catch (Exception ex)
            {
                _logger.LogError($"Error sending OTP to {toEmail}", ex);
                return false;
            }
        }

        public bool SendPasswordResetLink(string toEmail, string resetLink, string userName = "")
        {
            try
            {
                string subject = "🔑 Đặt lại mật khẩu TechWorld";
                string htmlBody = GeneratePasswordResetEmailTemplate(resetLink, userName);

                return SendGenericEmail(toEmail, subject, htmlBody);
            }
            catch (Exception ex)
            {
                _logger.LogError($"Error sending password reset link to {toEmail}", ex);
                return false;
            }
        }

        public bool SendOrderConfirmation(string toEmail, int orderId, decimal totalAmount)
        {
            try
            {
                string subject = $"📦 Xác nhận đơn hàng #{orderId}";
                string htmlBody = GenerateOrderConfirmationEmailTemplate(orderId, totalAmount);

                return SendGenericEmail(toEmail, subject, htmlBody);
            }
            catch (Exception ex)
            {
                _logger.LogError($"Error sending order confirmation to {toEmail}", ex);
                return false;
            }
        }

        public bool SendGenericEmail(string toEmail, string subject, string htmlBody)
        {
            try
            {
                _logger.LogInfo($"[EMAIL] Starting to send email to: {toEmail}, Subject: {subject}");
                _logger.LogInfo($"[EMAIL] SMTP Config: Server={_smtpServer}:{_smtpPort}, User={_smtpUsername}, SSL=enabled");

                System.Net.ServicePointManager.SecurityProtocol = System.Net.SecurityProtocolType.Tls12;

                using (SmtpClient smtpClient = new SmtpClient(_smtpServer, _smtpPort))
                {
                    smtpClient.EnableSsl = true;
                    smtpClient.UseDefaultCredentials = false;
                    smtpClient.Credentials = new NetworkCredential(_smtpUsername, _smtpPassword);
                    smtpClient.Timeout = 10000; // 10 seconds

                    _logger.LogInfo($"[EMAIL] SMTP client created and configured");

                    using (MailMessage mailMessage = new MailMessage())
                    {
                        mailMessage.From = new MailAddress(_senderEmail, _senderName);
                        mailMessage.To.Add(toEmail);
                        mailMessage.Subject = subject;
                        mailMessage.Body = htmlBody;
                        mailMessage.IsBodyHtml = true;
                        mailMessage.BodyEncoding = System.Text.Encoding.UTF8;
                        mailMessage.SubjectEncoding = System.Text.Encoding.UTF8;

                        // Add reply-to address for support
                        mailMessage.ReplyToList.Add(new MailAddress(ConfigurationManager.AppSettings["SupportEmail"] ?? _senderEmail));

                        _logger.LogInfo($"[EMAIL] Email message created - From: {mailMessage.From}, To: {toEmail}");
                        _logger.LogInfo($"[EMAIL] Attempting to send email via SMTP...");

                        smtpClient.Send(mailMessage);

                        _logger.LogInfo($"✅ [EMAIL] Email sent successfully to {toEmail} - Subject: {subject}");
                        return true;
                    }
                }
            }
            catch (SmtpException ex)
            {
                _logger.LogError($"❌ [EMAIL] SMTP Error sending email to {toEmail}");
                _logger.LogError($"   Exception Type: {ex.GetType().Name}");
                _logger.LogError($"   Status Code: {ex.StatusCode}");
                _logger.LogError($"   Message: {ex.Message}");
                _logger.LogError($"   Inner Exception: {ex.InnerException?.Message}");
                return false;
            }
            catch (Exception ex)
            {
                _logger.LogError($"❌ [EMAIL] Unexpected error sending email to {toEmail}");
                _logger.LogError($"   Exception Type: {ex.GetType().Name}");
                _logger.LogError($"   Message: {ex.Message}");
                _logger.LogError($"   Stack Trace: {ex.StackTrace}");
                return false;
            }
        }

