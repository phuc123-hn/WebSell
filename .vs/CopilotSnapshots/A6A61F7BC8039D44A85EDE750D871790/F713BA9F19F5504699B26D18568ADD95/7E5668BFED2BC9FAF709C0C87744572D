CREATE TRIGGER dbo.trg_CleanOldMessages
ON dbo.Messages
AFTER INSERT
AS
BEGIN
    SET NOCOUNT ON
    
    -- Delete messages older than 30 days
    DELETE FROM dbo.Messages
    WHERE CreatedAt < DATEADD(DAY, -30, GETUTCDATE())
        AND IsRead = 1
END
