@model web1.Models.Product

@{
    ViewBag.Title = "Thêm/Sửa sản phẩm - Admin";
}

<div class="row">
    <div class="col-md-8 offset-md-2">
        <h2>@(Model?.Id == 0 ? "Thêm sản phẩm" : "Sửa sản phẩm")</h2>

        <form method="post">
            @Html.AntiForgeryToken()
            <div class="card">
                <div class="card-body">
                    @if (ViewBag.Categories != null)
                    {
                        <div class="mb-3">
                            <label class="form-label">Danh mục</label>
                            @Html.DropDownListFor(m => m.CategoryId, ViewBag.Categories as SelectList, new { @class = "form-select" })
                        </div>
                    }

                    <div class="mb-3">
                        <label class="form-label">Tên sản phẩm</label>
                        @Html.TextBoxFor(m => m.Name, new { @class = "form-control" })
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Giá</label>
                        @Html.TextBoxFor(m => m.Price, new { @class = "form-control", type = "number", step = "1000" })
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Mô tả</label>
                        @Html.TextAreaFor(m => m.Description, new { @class = "form-control", rows = 5 })
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Link ảnh</label>
                        @Html.TextBoxFor(m => m.ImageUrl, new { @class = "form-control", placeholder = "~/Content/Images/product.jpg" })
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Tồn kho</label>
                        @Html.TextBoxFor(m => m.Stock, new { @class = "form-control", type = "number" })
                    </div>

                    <div class="mb-3">
                        <div class="form-check">
                            @Html.CheckBoxFor(m => m.IsHot)
                            <label class="form-check-label">Sản phẩm nổi bật</label>
                        </div>
                    </div>
                </div>

                <div class="card-footer">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save"></i> Lưu
                    </button>
                    <a href="@Url.Action("Index", "Product", new { area = "Admin" })" class="btn btn-secondary">
                        <i class="fas fa-times"></i> Hủy
                    </a>
                </div>
            </div>
        </form>
    </div>
</div>