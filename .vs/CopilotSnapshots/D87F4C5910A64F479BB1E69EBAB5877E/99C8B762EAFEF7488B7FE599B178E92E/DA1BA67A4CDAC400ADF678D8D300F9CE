@model web1.Models.Product

@{
    ViewBag.Title = "Thêm/Sửa sản phẩm - Admin";
}

<div class="row">
    <div class="col-md-8 offset-md-2">
        <h2>@(Model?.Id == 0 ? "Thêm sản phẩm" : "Sửa sản phẩm")</h2>

        <form method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <div class="card">
                <div class="card-body">
                    @if (ViewBag.Categories != null)
                    {
                        <div class="mb-3">
                            <label class="form-label">Danh mục</label>
                            @Html.DropDownListFor(m => m.CategoryId, ViewBag.Categories as SelectList, new { @class = "form-select" })
                        </div>
                    }

                    <div class="mb-3">
                        <label class="form-label">Tên sản phẩm</label>
                        @Html.TextBoxFor(m => m.Name, new { @class = "form-control" })
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Giá</label>
                        @Html.TextBoxFor(m => m.Price, new { @class = "form-control", type = "number", step = "1000" })
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Mô tả</label>
                        @Html.TextAreaFor(m => m.Description, new { @class = "form-control", rows = 5 })
                    </div>

                    <!-- Upload Ảnh -->
                    <div class="mb-3">
                        <label class="form-label">Upload Ảnh</label>
                        <input type="file" id="imageUpload" name="imageFile" class="form-control" accept=".jpg,.jpeg,.png,.gif,.webp" />
                        <small class="text-muted">Định dạng: JPG, PNG, GIF, WEBP. Dung lượng tối đa: 5MB</small>
                    </div>

                    <!-- Preview Ảnh -->
                    <div class="mb-3">
                        <label class="form-label">Preview Ảnh</label>
                        <div id="imagePreview" style="display: none; text-align: center;">
                            <img id="previewImg" src="" alt="Preview" style="max-width: 100%; max-height: 300px; border-radius: 8px;" />
                        </div>
                        @if (Model != null && Model.Id > 0 && !string.IsNullOrEmpty(Model.ImageUrl))
                        {
                            <div style="text-align: center;">
                                <img src="@Url.Content(Model.ImageUrl)" alt="@Model.Name" style="max-width: 100%; max-height: 300px; border-radius: 8px;" />
                                <p class="text-muted" style="margin-top: 10px;">Ảnh hiện tại</p>
                            </div>
                        }
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Tồn kho</label>
                        @Html.TextBoxFor(m => m.Stock, new { @class = "form-control", type = "number" })
                    </div>

                    <div class="mb-3">
                        <div class="form-check">
                            @Html.CheckBoxFor(m => m.IsHot)
                            <label class="form-check-label">Sản phẩm nổi bật</label>
                        </div>
                    </div>
                </div>

                <div class="card-footer">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save"></i> Lưu
                    </button>
                    <a href="@Url.Action("Index", "Product", new { area = "Admin" })" class="btn btn-secondary">
                        <i class="fas fa-times"></i> Hủy
                    </a>
                </div>
            </div>
        </form>
    </div>
</div>

<script>
document.getElementById('imageUpload').addEventListener('change', function(e) {
    const file = e.target.files[0];
    if (file) {
        const reader = new FileReader();
        reader.onload = function(event) {
            const previewImg = document.getElementById('previewImg');
            previewImg.src = event.target.result;
            document.getElementById('imagePreview').style.display = 'block';
        };
        reader.readAsDataURL(file);
    } else {
        document.getElementById('imagePreview').style.display = 'none';
    }
});
</script>