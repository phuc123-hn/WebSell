@model List<web1.Models.Post>

@{
    ViewBag.Title = "Quản Lý Bài Đăng";
    ViewBag.CurrentTab = "admin";
    Layout = "~/Areas/Community/Views/Shared/_CommunityLayout.cshtml";
}

<div class="container-fluid">
    <div class="alert alert-warning alert-dismissible fade show" role="alert">
        <i class="fas fa-shield-alt"></i>
        <strong>Admin Panel:</strong> Xóa bài vi phạm. Bài bị xóa sẽ ẩn khỏi công khai nhưng vẫn lưu trong hệ thống (soft delete).
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>

    <h2 style="margin-bottom: 20px; color: #333;">
        <i class="fas fa-list"></i> Quản Lý Bài Đăng (@(Model != null ? Model.Count : 0))
    </h2>

    @if (Model != null && Model.Count > 0)
    {
        <div class="table-responsive">
            <table class="table table-hover" style="background: white;">
                <thead style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white;">
                    <tr>
                        <th style="width: 5%;">ID</th>
                        <th style="width: 15%;">Tiêu Đề</th>
                        <th style="width: 15%;">Tác Giả</th>
                        <th style="width: 10%;">Loại</th>
                        <th style="width: 15%;">Ngày Tạo</th>
                        <th style="width: 10%;">Like</th>
                        <th style="width: 10%;">Comment</th>
                        <th style="width: 15%;">Trạng Thái</th>
                        <th style="width: 20%;">Hành Động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var post in Model.OrderByDescending(p => p.CreatedAt))
                    {
                        var likeCount = post.Likes != null ? post.Likes.Count : 0;
                        var commentCount = post.Comments != null ? post.Comments.Where(c => !c.IsDeleted).Count() : 0;
                        var typeText = post.Type == 0 ? "Đánh Giá" : "Cho Thuê";
                        var statusText = post.IsDeleted ? "Đã Xóa" : "Đang Hiển Thị";
                        var statusColor = post.IsDeleted ? "danger" : "success";

                        <tr data-post-id="@post.Id" style="@(post.IsDeleted ? "background: #fee; opacity: 0.7;" : "")">
                            <td style="font-weight: 600;">@post.Id</td>
                            <td>
                                <strong>@post.Title.Substring(0, Math.Min(30, post.Title.Length))</strong>
                                @if (post.Title.Length > 30)
                                {
                                    <text>...</text>
                                }
                            </td>
                            <td>@post.User.FullName</td>
                            <td>
                                <span class="badge @(post.Type == 0 ? "badge-info" : "badge-warning")">
                                    @typeText
                                </span>
                            </td>
                            <td>@post.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                <span class="badge badge-primary">@likeCount</span>
                            </td>
                            <td>
                                <span class="badge badge-secondary">@commentCount</span>
                            </td>
                            <td>
                                <span class="badge badge-@statusColor">@statusText</span>
                            </td>
                            <td>
                                <a href="@Url.Action("Detail", "Post", new { area = "Community", id = post.Id })"
                                   class="btn btn-sm btn-info" target="_blank">
                                    <i class="fas fa-eye"></i> Xem
                                </a>

                                @if (post.IsDeleted)
                                {
                                    <button onclick="restorePost(@post.Id)" class="btn btn-sm btn-success">
                                        <i class="fas fa-undo"></i> Khôi Phục
                                    </button>
                                }
                                else
                                {
                                    <button onclick="warningPost(@post.Id)" class="btn btn-sm btn-warning" title="Cảnh báo bài viết">
                                        <i class="fas fa-exclamation-triangle"></i> Cảnh Báo
                                    </button>
                                    <button onclick="deletePost(@post.Id)" class="btn btn-sm btn-danger">
                                        <i class="fas fa-trash"></i> Xóa
                                    </button>
                                    <button onclick="banUser(@post.UserId)" class="btn btn-sm btn-dark">
                                        <i class="fas fa-ban"></i> Ban User
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-state">
            <i class="fas fa-inbox"></i>
            <h3>Chưa có bài đăng</h3>
            <p>Không có bài đăng nào trong hệ thống</p>
        </div>
    }
</div>

@section scripts {
    <script>
        function deletePost(postId) {
            if (confirm('Xóa bài này? (Bài sẽ ẩn khỏi công khai)')) {
                $.post('@Url.Action("DeletePost", "Admin", new { area = "Community" })',
                    { id: postId },
                    function (result) {
                        if (result.success) {
                            alert(result.message);
                            location.reload();
                        } else {
                            alert(result.message);
                        }
                    }
                );
            }
        }

        function warningPost(postId) {
            var reason = prompt('Nhập lý do cảnh báo:');
            if (reason) {
                $.post('@Url.Action("WarningPost", "Admin", new { area = "Community" })',
                    { id: postId, reason: reason },
                    function (result) {
                        if (result.success) {
                            alert(result.message);
                            location.reload();
                        } else {
                            alert(result.message);
                        }
                    }
                );
            }
        }

        function banUser(userId) {
            var banDays = prompt('Số ngày cấm (mặc định 7):', '7');
            if (banDays !== null) {
                var reason = prompt('Lý do cấm:');
                if (reason) {
                    $.post('@Url.Action("BanUser", "Admin", new { area = "Community" })',
                        { userId: userId, reason: reason, banDays: parseInt(banDays) },
                        function (result) {
                            if (result.success) {
                                alert(result.message);
                                location.reload();
                            } else {
                                alert(result.message);
                            }
                        }
                    );
                }
            }
        }

        function restorePost(postId) {
            if (confirm('Khôi phục bài này?')) {
                $.post('@Url.Action("RestorePost", "Admin", new { area = "Community" })',
                    { id: postId },
                    function (result) {
                        if (result.success) {
                            alert(result.message);
                            location.reload();
                        } else {
                            alert(result.message);
                        }
                    }
                );
            }
        }
    </script>
}