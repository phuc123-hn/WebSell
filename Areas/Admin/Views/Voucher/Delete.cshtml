@model web1.Models.Voucher

@{
    ViewBag.Title = "Xóa Voucher - Admin";
}

<div class="row mb-3">
    <div class="col-md-6">
        <h2 style="color: #FFD700;">Xóa Voucher</h2>
    </div>
    <div class="col-md-6 text-right">
        <a href="@Url.Action("Index", "Voucher", new { area = "Admin" })" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Quay lại
        </a>
    </div>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="card border-danger">
            <div class="card-header bg-danger text-white">
                <h5 class="mb-0"><i class="fas fa-exclamation-triangle"></i> Xác nhận xóa</h5>
            </div>
            <div class="card-body">
                <div class="alert alert-warning">
                    <strong>Cảnh báo!</strong> Bạn sắp xóa voucher. Hành động này không thể hoàn tác!
                </div>

                <h5 style="color: #FFD700;">@Model.Name</h5>

                <div class="row mb-3">
                    <div class="col-md-6" style="color:yellow">
                        <p><strong>Mã:</strong> <code>@Model.Code</code></p>
                    </div>
                    <div class="col-md-6" style="color:yellow">
                        <p><strong>Trạng thái:</strong> @(Model.IsActive ? "Hoạt động" : "Vô hiệu")</p>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6" style="color:yellow">
                        @if (Model.DiscountPercent > 0)
                        {
                            <p><strong>Giảm:</strong> -@Model.DiscountPercent%</p>
                        }
                        @if (Model.DiscountAmount > 0)
                        {
                            <p><strong>Giảm:</strong> -@Model.DiscountAmount.ToString("N0")đ</p>
                        }
                    </div>
                    <div class="col-md-6" style="color:yellow">
                        <p><strong>Đã sử dụng:</strong> @Model.UsedQuantity</p>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6" style="color:yellow">
                        <p><strong>Từ:</strong> @Model.StartDate.ToString("dd/MM/yyyy")</p>
                    </div>
                    <div class="col-md-6" style="color:yellow">
                        <p><strong>Đến:</strong> @Model.EndDate.ToString("dd/MM/yyyy")</p>
                    </div>
                </div>

                <hr />

                @using (Html.BeginForm("Delete", "Voucher", new { area = "Admin" }, FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(model => model.Id)

                    <button type="submit" class="btn btn-danger btn-lg">
                        <i class="fas fa-trash"></i> Xóa voucher
                    </button>
                    <a href="@Url.Action("Index", "Voucher", new { area = "Admin" })" class="btn btn-secondary btn-lg">
                        <i class="fas fa-times"></i> Hủy
                    </a>
                }
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card bg-light">
            <div class="card-header bg-info text-white">
                <h5 class="mb-0">Thông tin</h5>
            </div>
            <div class="card-body">
                <p><strong>Mã voucher:</strong><br/>
                <code>@Model.Code</code></p>
                <p><strong>Tạo lúc:</strong> @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</p>
            </div>
        </div>
    </div>
</div>
