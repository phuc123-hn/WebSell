@model web1.Models.Voucher

@{
    ViewBag.Title = "Chi tiết Voucher - Admin";
}

<div class="row mb-3">
    <div class="col-md-8">
        <h2 style="color: #FFD700;">Chi tiết Voucher</h2>
    </div>
    <div class="col-md-4 text-right">
        <a href="@Url.Action("Edit", "Voucher", new { area = "Admin", id = Model.Id })" class="btn btn-warning">
            <i class="fas fa-edit"></i> Sửa
        </a>
        <a href="@Url.Action("Index", "Voucher", new { area = "Admin" })" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Quay lại
        </a>
    </div>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title" style="color: #FFD700;">@Model.Name</h5>
                <hr />

                <div class="row mb-3">
                    <div class="col-md-6">
                        <p><strong>Mã voucher:</strong> <span class="badge bg-primary">@Model.Code</span></p>
                        <p><strong>Trạng thái:</strong> 
                            @if (Model.IsActive)
                            {
                                <span class="badge bg-success">Đang hoạt động</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Vô hiệu</span>
                            }
                        </p>
                    </div>
                    <div class="col-md-6">
                        <p><strong>Ngày tạo:</strong> @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</p>
                        <p><strong>Cập nhật lần cuối:</strong> @Model.UpdatedAt?.ToString("dd/MM/yyyy HH:mm")</p>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        @if (Model.DiscountPercent > 0)
                        {
                            <p><strong>Giảm:</strong> <span class="badge bg-success">@Model.DiscountPercent%</span></p>
                        }
                        @if (Model.DiscountAmount > 0)
                        {
                            <p><strong>Giảm:</strong> <span class="badge bg-success">@Model.DiscountAmount.ToString("N0")đ</span></p>
                        }
                    </div>
                    <div class="col-md-6">
                        <p><strong>Đơn tối thiểu:</strong> @Model.MinOrderAmount.ToString("N0")đ</p>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <p><strong>Ngày bắt đầu:</strong> @Model.StartDate.ToString("dd/MM/yyyy HH:mm")</p>
                    </div>
                    <div class="col-md-6">
                        <p><strong>Ngày kết thúc:</strong> @Model.EndDate.ToString("dd/MM/yyyy HH:mm")</p>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <p><strong>Số lượng:</strong> @(Model.Quantity > 0 ? Model.Quantity + " cái" : "Vô hạn")</p>
                    </div>
                    <div class="col-md-6">
                        <p><strong>Đã sử dụng:</strong> @Model.UsedQuantity</p>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(Model.Description))
                {
                    <div class="mb-3">
                        <p><strong>Mô tả:</strong></p>
                        <p>@Model.Description</p>
                    </div>
                }

                @if (Model.EventId.HasValue && ViewBag.UsageHistory != null)
                {
                    <hr />
                    <h5 style="color: #FFD700;">Lịch sử sử dụng</h5>
                    if (((List<web1.Models.VoucherUsage>)ViewBag.UsageHistory).Count > 0)
                    {
                        <div class="table-responsive">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>Người dùng</th>
                                        <th>Ngày sử dụng</th>
                                        <th>Đơn hàng</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var usage in (List<web1.Models.VoucherUsage>)ViewBag.UsageHistory)
                                    {
                                        <tr>
                                            <td>@usage.User?.FullName</td>
                                            <td>@usage.UsedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                            <td>
                                                @if (usage.Order != null)
                                                {
                                                    <a href="@Url.Action("Details", "Order", new { area = "Admin", id = usage.Order.Id })" class="btn btn-sm btn-info">
                                                        #@usage.Order.Id
                                                    </a>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">Chưa có sử dụng</p>
                    }
                }
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card bg-light">
            <div class="card-header bg-info text-white">
                <h5 class="mb-0">Thống kê</h5>
            </div>
            <div class="card-body">
                <p>
                    <strong>Còn lại:</strong> 
                    @if (Model.Quantity > 0)
                    {
                        <span class="badge bg-primary">@(Model.Quantity - Model.UsedQuantity)</span>
                    }
                    else
                    {
                        <span class="badge bg-success">Vô hạn</span>
                    }
                </p>
            </div>
        </div>

        <div class="card mt-3">
            <div class="card-header bg-warning text-dark">
                <h5 class="mb-0">Hành động</h5>
            </div>
            <div class="card-body">
                <a href="@Url.Action("Edit", "Voucher", new { area = "Admin", id = Model.Id })" class="btn btn-warning btn-sm w-100 mb-2">
                    <i class="fas fa-edit"></i> Sửa
                </a>
                <a href="@Url.Action("Index", "Voucher", new { area = "Admin" })" class="btn btn-secondary btn-sm w-100">
                    <i class="fas fa-arrow-left"></i> Quay lại danh sách
                </a>
            </div>
        </div>
    </div>
</div>
