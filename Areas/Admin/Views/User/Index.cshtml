@model List<web1.Models.User>

@{
    ViewBag.Title = "Quản lý người dùng - Admin";
}

<div class="row mb-3">
    <div class="col-md-6">
        <h2>Quản lý người dùng</h2>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<div class="table-responsive">
    <table class="table table-bordered table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th style="width: 5%;">ID</th>
                <th style="width: 12%;">Tên đăng nhập</th>
                <th style="width: 12%;">Họ và tên</th>
                <th style="width: 15%;">Email</th>
                <th style="width: 10%;">Số điện thoại</th>
                <th style="width: 8%;">Vai trò</th>
                <th style="width: 12%;">Xác minh</th>
                <th style="width: 13%;">Ngày tạo</th>
                <th style="width: 13%;">Hành động</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Count > 0)
            {
                foreach (var user in Model)
                {
                    <tr>
                        <td>@user.Id</td>
                        <td>@user.Username</td>
                        <td>@user.FullName</td>
                        <td>@user.Email</td>
                        <td>@user.Phone</td>
                        <td>
                            @if (user.Role == "Admin")
                            {
                                <span class="badge bg-danger">Admin</span>
                            }
                            else
                            {
                                <span class="badge bg-info">Customer</span>
                            }
                        </td>
                        <td>
                            @if (user.IsVerified)
                            {
                                <span class="badge bg-success"><i class="fas fa-check"></i> Đã xác minh</span>
                            }
                            else
                            {
                                <span class="badge bg-warning"><i class="fas fa-times"></i> Chưa xác minh</span>
                            }
                        </td>
                        <td>@user.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>
                            <a href="@Url.Action("Details", "User", new { area = "Admin", id = user.Id })" class="btn btn-sm btn-info" title="Xem chi tiết">
                                <i class="fas fa-eye"></i> Xem
                            </a>
                            @if (user.Role != "Admin")
                            {
                                <a href="@Url.Action("Delete", "User", new { area = "Admin", id = user.Id })" class="btn btn-sm btn-danger" onclick="return confirm('Bạn có chắc chắn muốn xóa?');" title="Xóa người dùng">
                                    <i class="fas fa-trash"></i> Xóa
                                </a>
                            }
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="9" class="text-center">Không có người dùng nào</td>
                </tr>
            }
        </tbody>
    </table>
</div>
