@model web1.Models.Product

@{
    ViewBag.Title = "Xóa sản phẩm - Admin";
}

<div class="row">
    <div class="col-md-6 offset-md-3">
        <div class="card border-danger">
            <div class="card-header bg-danger text-white">
                <h5 class="mb-0">Xác nhận xóa</h5>
            </div>
            <div class="card-body">
                <p>Bạn có chắc chắn muốn xóa sản phẩm này?</p>
                <p><strong>@Model.Name</strong></p>

                <form method="post">
                    <button type="submit" class="btn btn-danger" name="confirm" value="true">
                        <i class="fas fa-trash"></i> Xóa
                    </button>
                    <a href="@Url.Action("Index", "Product", new { area = "Admin" })" class="btn btn-secondary">
                        <i class="fas fa-times"></i> Hủy
                    </a>
                </form>
            </div>
        </div>
    </div>
</div>