@model List<web1.Models.EventQuestion>

@{
    ViewBag.Title = ViewBag.EventName + " - Danh sách câu hỏi - Admin";
}

<div class="row mb-3">
    <div class="col-md-6">
        <h2 style="color: #FFD700;">@ViewBag.EventName - Danh sách câu hỏi</h2>
    </div>
    <div class="col-md-6 text-right">
        <a href="@Url.Action("Detail", "Event", new { area = "Admin", id = ViewBag.EventId })" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Quay lại chi tiết sự kiện
        </a>
    </div>
</div>

@if (Model != null && Model.Count > 0)
{
    <div class="table-responsive">
        <table class="table table-bordered table-striped">
            <thead class="table-dark">
                <tr>
                    <th style="width: 5%; color: #FFD700;">STT</th>
                    <th style="width: 40%; color: #FFD700;">Câu hỏi</th>
                    <th style="width: 10%; color: #FFD700;">Đáp án đúng</th>
                    <th style="width: 45%; color: #FFD700;">Chi tiết đáp án</th>
                </tr>
            </thead>
            <tbody>
                @for (int i = 0; i < Model.Count; i++)
                {
                    var question = Model[i];
                    <tr style="color: #FFD700;">
                        <td>@(i + 1)</td>
                        <td>@question.Question</td>
                        <td>
                            <span class="badge bg-success">@question.CorrectAnswer</span>
                        </td>
                        <td>
                            <small>
                                A: @question.OptionA<br>
                                B: @question.OptionB<br>
                                C: @question.OptionC<br>
                                D: @question.OptionD
                            </small>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="alert alert-info" style="color: #FFD700;">
        <i class="fas fa-info-circle"></i> Chưa có câu hỏi nào. 
        <a href="@Url.Action("Detail", "Event", new { area = "Admin", id = ViewBag.EventId })" class="alert-link">Quay lại để thêm câu hỏi</a>
    </div>
}
