@model web1.Models.News

@{
    ViewBag.Title = "Xóa tin tức - Admin";
}

<div class="row mb-3">
    <div class="col-md-6">
        <h2>Xóa tin tức</h2>
    </div>
    <div class="col-md-6 text-right">
        <a href="@Url.Action("Index", "News", new { area = "Admin" })" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Quay lại
        </a>
    </div>
</div>

<div class="alert alert-danger" role="alert">
    <strong><i class="fas fa-exclamation-triangle"></i> Cảnh báo!</strong> Bạn sắp xóa tin tức này. Hành động này không thể hoàn tác.
</div>

<div class="row">
    <div class="col-md-8">
        <div class="card border-danger">
            <div class="card-header bg-danger text-white">
                <h5 class="mb-0"><i class="fas fa-trash"></i> Thông tin tin tức cần xóa</h5>
            </div>
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-md-6">
                        <p><strong>ID:</strong> @Model.Id</p>
                        <p><strong>Tiêu đề:</strong> @Model.Title</p>
                        <p><strong>Danh mục:</strong> @Model.Category</p>
                    </div>
                    <div class="col-md-6">
                        <p><strong>Ngày đăng:</strong> @Model.PublishDate.ToString("dd/MM/yyyy HH:mm")</p>
                        <p><strong>Trạng thái:</strong> @(Model.IsActive ? "Hoạt động" : "Ẩn")</p>
                    </div>
                </div>

                <hr />

                <h6>Nội dung:</h6>
                <p>@Model.Content</p>

                <div class="alert alert-info mt-3">
                    <strong><i class="fas fa-info-circle"></i> Lưu ý:</strong>
                    <ul class="mb-0">
                        <li>Tin tức này sẽ bị xóa vĩnh viễn</li>
                        <li>Không thể khôi phục sau khi xóa</li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="mt-4">
            @using (Html.BeginForm("Delete", "News", new { area = "Admin" }, FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(model => model.Id)

                <button type="submit" class="btn btn-danger btn-lg">
                    <i class="fas fa-trash"></i> Xác nhận xóa tin tức
                </button>
                <a href="@Url.Action("Index", "News", new { area = "Admin" })" class="btn btn-secondary btn-lg">
                    <i class="fas fa-times"></i> Không xóa
                </a>
            }
        </div>
    </div>
</div>
