@model List<web1.Models.News>
@{
    ViewBag.Title = "Tin tức - TechWorld";
}

<style>
    /* News page specific styles */
    body {
        background: linear-gradient(135deg, #07091A 0%, #0F1628 100%);
        color: var(--text);
        font-family: 'Be Vietnam Pro', sans-serif;
        overflow-x: hidden;
    }

    .news-container {
        padding: 20px 0;
    }

    .news-card {
        border: none;
        background: white;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
        margin-bottom: 20px;
    }

    .news-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
    }

    .news-image {
        width: 100%;
        height: 200px;
        object-fit: cover;
        border-radius: 12px 0 0 12px;
    }

    .news-title {
        color: #2f3542;
        font-weight: 600;
        transition: color 0.3s;
    }

    .news-title:hover {
        color: #667eea;
    }

    .news-badge {
        display: inline-block;
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 0.85rem;
        font-weight: 600;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        transition: all 0.3s;
    }

    .sidebar-title {
        color: #2f3542;
        font-weight: 600;
        border-bottom: 2px solid #667eea;
        padding-bottom: 10px;
    }

    .sidebar-list a {
        color: #2f3542;
        text-decoration: none;
        transition: all 0.3s;
        padding: 8px 12px;
        display: block;
        border-radius: 6px;
    }

    .sidebar-list a:hover {
        color: white;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        padding-left: 18px;
    }
</style>

<div class="news-container">
    <div class="col-12">
        <h2 class="mb-4">
            <i class="fas fa-newspaper"></i> 
                Tin tức công nghệ & quốc phòng
        </h2>
    </div>
</div>

<div class="row">
    <div class="col-md-3">
        <!-- Sidebar giữ nguyên -->
        <div class="sidebar">
            <h4 class="sidebar-title">Danh mục tin tức</h4>
            <ul class="sidebar-list">
                <li><a href="@Url.Action("Index", "News")">Tất cả tin tức</a></li>
                <li><a href="@Url.Action("Index", "News", new { category = "Technology" })"><i class="fas fa-microchip"></i> Công nghệ</a></li>
                <li><a href="@Url.Action("Index", "News", new { category = "Defense" })"><i class="fas fa-shield-alt"></i> Quốc phòng</a></li>
            </ul>
        </div>
    </div>

    <div class="col-md-9">
        @if (Model != null && Model.Count > 0)
        {
            foreach (var news in Model)
            {
                <div class="card mb-4 news-card" style="border: none; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);">
                    <div class="row g-0">
                        <!-- PHẦN ẢNH ĐÃ SỬA -->
                        <div class="col-md-3">
                            @if (!string.IsNullOrEmpty(news.ImageUrl))
                            {
                                <img src="@Url.Content(news.ImageUrl)"
                                     alt="@news.Title"
                                     class="img-fluid news-image"
                                     style="width: 100%; height: 200px; object-fit: cover; border-radius: 8px;">
                            }
                            else
                            {
                                <!-- Placeholder nếu chưa có ảnh -->
                                <div style="background: #f0f0f0; height: 200px; display: flex; align-items: center; justify-content: center;">
                                    <i class="fas fa-image" style="font-size: 3rem; color: #ddd;"></i>
                                </div>
                            }
                        </div>

                        <div class="col-md-9">
                            <div class="card-body">
                                <div style="margin-bottom: 10px;">
                                    <span class="news-badge">@news.Category</span>
                                    <span class="text-muted" style="font-size: 0.9rem;">
                                        <i class="fas fa-calendar"></i> @news.PublishDate.ToString("dd/MM/yyyy HH:mm")
                                    </span>
                                </div>
                                <h5 class="card-title">
                                    <a href="@Url.Action("Details", "News", new { id = news.Id })" class="news-title" style="color: #333; text-decoration: none;">
                                        @news.Title
                                    </a>
                                </h5>
                                <p class="card-text text-muted">@news.Summary</p>
                                
                                <!-- DEBUG - xóa sau khi test 
                                <p style="color: red; font-size: 12px; margin: 5px 0;">
                                    Debug ImageUrl: <strong>@news.ImageUrl</strong>
                                </p> -->
                                
                                <a href="@Url.Action("Details", "News", new { id = news.Id })" class="btn btn-lift btn-sm">
                                    Đọc tiếp <i class="fas fa-arrow-right"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="alert alert-info">
                <i class="fas fa-info-circle"></i> Không có tin tức nào
            </div>
        }
    </div>
</div>