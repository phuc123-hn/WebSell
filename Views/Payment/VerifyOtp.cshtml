@{
    ViewBag.Title = "Xác Minh OTP - Thanh Toán";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow">
                <div class="card-body p-4">
                    <div class="text-center mb-4">
                        <i class="fas fa-lock" style="font-size: 48px; color: #28a745;"></i>
                        <h3 class="mt-3">Xác Minh Thanh Toán</h3>
                        <p class="text-muted text-sm">Nhập mã OTP để xác nhận giao dịch</p>
                    </div>

                    @if (!string.IsNullOrEmpty(ViewBag.Error))
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="fas fa-exclamation-circle"></i> @ViewBag.Error
                            <button type="button" class="close" data-dismiss="alert"></button>
                        </div>
                    }

                    <div class="order-info mb-4">
                        <div class="info-row">
                            <span>Đơn hàng ID:</span>
                            <strong>@ViewBag.OrderId</strong>
                        </div>
                        <div class="info-row">
                            <span>Số tiền:</span>
                            <strong class="text-danger">@ViewBag.Amount?.ToString("N0") VNĐ</strong>
                        </div>
                        <div class="info-row">
                            <span>Số điện thoại:</span>
                            <strong>@ViewBag.Phone</strong>
                        </div>
                    </div>

                    <form method="post" action="@Url.Action("ConfirmPaymentWithOtp", "Payment")" id="paymentOtpForm">
                        @Html.AntiForgeryToken()

                        <input type="hidden" name="orderId" value="@ViewBag.OrderId" />
                        <input type="hidden" name="amount" value="@ViewBag.Amount" />

                        <div class="form-group mb-4">
                            <label for="paymentOtp">
                                <i class="fas fa-key"></i> Mã OTP (6 chữ số)
                            </label>
                            <input type="text"
                                   class="form-control form-control-lg text-center"
                                   id="paymentOtp"
                                   name="otp"
                                   maxlength="6"
                                   inputmode="numeric"
                                   placeholder="000000"
                                   autocomplete="off"
                                   required
                                   style="font-size: 24px; letter-spacing: 8px;" />
                            <small class="form-text text-muted d-block mt-2">
                                Mã hết hạn trong <span id="otpTimer">5:00</span>
                            </small>
                        </div>

                        <button type="submit" class="btn btn-success btn-lg btn-block" id="confirmPaymentBtn">
                            <i class="fas fa-credit-card"></i> Xác Nhận Thanh Toán
                        </button>
                    </form>

                    <hr />

                    <div class="text-center">
                        <p class="mb-2 text-sm">Chưa nhận được mã?</p>
                        <button type="button" class="btn btn-sm btn-outline-secondary" id="resendPaymentOtpBtn">
                            <i class="fas fa-redo"></i> Gửi Lại OTP
                        </button>
                        <div id="paymentCooldown" style="margin-top: 10px; display: none;">
                            <p class="text-muted text-sm">
                                Chờ <strong id="paymentCountdown">60</strong>s
                            </p>
                        </div>
                    </div>

                    <div style="margin-top: 15px; text-align: center;">
                        <a href="@Url.Action("MyOrders", "AccountProfile")" class="text-muted text-sm">
                            <i class="fas fa-times"></i> Hủy
                        </a>
                    </div>
                </div>
            </div>

            <div class="alert alert-warning mt-3 text-sm">
                <i class="fas fa-exclamation-triangle"></i>
                <strong>Lưu ý:</strong>
                Không bao giờ chia sẻ mã OTP này với bất kỳ ai, kể cả nhân viên hỗ trợ khách hàng.
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
var otpExpireTime = 5 * 60; // 5 minutes
var paymentResendCooldown = 0;
var otpTimerInterval;
var resendTimerInterval;

$(document).ready(function() {
    // Auto-focus OTP input
    $('#paymentOtp').focus();

    // Only allow numbers
    $('#paymentOtp').on('keypress', function(e) {
        if (!/[0-9]/.test(e.key)) {
            e.preventDefault();
        }
    });

    // Start OTP expiry timer
    startOtpTimer();

    // Form submission
    $('#paymentOtpForm').on('submit', function() {
        $('#confirmPaymentBtn').prop('disabled', true)
            .html('<i class="fas fa-spinner fa-spin"></i> Đang xác nhận...');
    });

    // Resend OTP
    $('#resendPaymentOtpBtn').on('click', function() {
        resendPaymentOtp();
    });
});

function startOtpTimer() {
    otpExpireTime = 5 * 60;
    clearInterval(otpTimerInterval);

    otpTimerInterval = setInterval(function() {
        otpExpireTime--;

        var minutes = Math.floor(otpExpireTime / 60);
        var seconds = otpExpireTime % 60;
        $('#otpTimer').text(minutes + ':' + (seconds < 10 ? '0' : '') + seconds);

        if (otpExpireTime <= 0) {
            clearInterval(otpTimerInterval);
            // Show expired message
            var alert = $('<div class="alert alert-danger alert-dismissible fade show" role="alert">' +
                '<i class="fas fa-exclamation-circle"></i> Mã OTP đã hết hạn. Vui lòng yêu cầu mã mới.' +
                '<button type="button" class="close" data-dismiss="alert"></button>' +
                '</div>');
            $('#paymentOtpForm').before(alert);
            $('#paymentOtp').prop('disabled', true);
            $('#confirmPaymentBtn').prop('disabled', true);
        }
    }, 1000);
}

function resendPaymentOtp() {
    var orderId = $('input[name="orderId"]').val();

    $.post('@Url.Action("SendOtpPayment", "Payment")', {
        orderId: orderId,
        __RequestVerificationToken: $('[name=__RequestVerificationToken]').val()
    }, function(response) {
        if (response.success) {
            startOtpTimer();
            var alert = $('<div class="alert alert-success alert-dismissible fade show" role="alert">' +
                '<i class="fas fa-check-circle"></i> Mã OTP mới đã được gửi!' +
                '<button type="button" class="close" data-dismiss="alert"></button>' +
                '</div>');
            $('#paymentOtpForm').before(alert);
            $('#paymentOtp').val('').prop('disabled', false).focus();
            $('#confirmPaymentBtn').prop('disabled', false);
            startResendCooldown();
        } else {
            var alert = $('<div class="alert alert-danger alert-dismissible fade show" role="alert">' +
                '<i class="fas fa-exclamation-circle"></i> ' + (response.message || 'Lỗi gửi OTP') +
                '<button type="button" class="close" data-dismiss="alert"></button>' +
                '</div>');
            $('#paymentOtpForm').before(alert);
        }
    }).fail(function() {
        var alert = $('<div class="alert alert-danger alert-dismissible fade show" role="alert">' +
            '<i class="fas fa-exclamation-circle"></i> Lỗi kết nối, vui lòng thử lại' +
            '<button type="button" class="close" data-dismiss="alert"></button>' +
            '</div>');
        $('#paymentOtpForm').before(alert);
    });
}

function startResendCooldown() {
    paymentResendCooldown = 60;
    $('#resendPaymentOtpBtn').prop('disabled', true);
    $('#paymentCooldown').show();

    clearInterval(resendTimerInterval);
    resendTimerInterval = setInterval(function() {
        paymentResendCooldown--;
        $('#paymentCountdown').text(paymentResendCooldown);

        if (paymentResendCooldown <= 0) {
            clearInterval(resendTimerInterval);
            $('#resendPaymentOtpBtn').prop('disabled', false);
            $('#paymentCooldown').hide();
        }
    }, 1000);
}
    </script>
}