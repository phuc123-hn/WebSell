@model List<web1.Models.CartItem>

@{
    ViewBag.Title = "Giỏ hàng - TechWorld";
}

<div class="row">
    <div class="col-12">
        <h2 class="mb-4">
            <i class="fas fa-shopping-cart"></i> Giỏ hàng
        </h2>

        @if (Model != null && Model.Count > 0)
        {
            <div class="table-responsive">
                <table class="table table-bordered table-striped">
                    <thead class="table-dark">
                        <tr>
                            <th>Sản phẩm</th>
                            <th style="width: 150px;">Giá</th>
                            <th style="width: 150px;">Số lượng</th>
                            <th style="width: 150px;">Tổng</th>
                            <th style="width: 100px;">Hành động</th>
                        </tr>
                    </thead>
                    <tbody id="cartTableBody">
                        @foreach (var item in Model)
                        {
                            <tr class="cart-item-row" data-product-id="@item.ProductId" data-price="@item.Price" data-quantity="@item.Quantity">
                                <td>
                                    <strong>@item.ProductName</strong>
                                </td>
                                <td>
                                    @item.Price.ToString("N0") đ
                                </td>
                                <td>
                                    <div class="input-group">
                                        <button class="btn btn-sm btn-outline-secondary" onclick="updateQty(@item.ProductId, @(item.Quantity - 1))">-</button>
                                        <input type="number" class="form-control form-control-sm text-center" value="@item.Quantity" style="width: 60px;"
                                               onchange="updateQty(@item.ProductId, this.value)">
                                        <button class="btn btn-sm btn-outline-secondary" onclick="updateQty(@item.ProductId, @(item.Quantity + 1))">+</button>
                                    </div>
                                </td>
                                <td>
                                    <strong>@item.TotalPrice.ToString("N0") đ</strong>
                                </td>
                                <td>
                                    <button class="btn btn-sm btn-danger" onclick="removeFromCart(@item.ProductId)">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="row mt-4">
                <div class="col-md-6">
                    <a href="@Url.Action("Index", "Product")" class="btn btn-secondary btn-lg">
                        <i class="fas fa-arrow-left"></i> Tiếp tục mua sắm
                    </a>
                </div>
                <div class="col-md-6 text-end">
                    <div class="card">
                        <div class="card-body">
                            <h5 class="card-title">Tóm tắt đơn hàng</h5>
                            <div class="d-flex justify-content-between mb-2">
                                <span>Tạm tính:</span>
                                <strong id="subtotal">0 đ</strong>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span>Mã giảm giá:</span>
                                <strong id="discount">0 đ</strong>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span>Phí vận chuyển:</span>
                                <strong>30,000 đ</strong>
                            </div>
                            <hr>
                            <div class="d-flex justify-content-between" style="font-size: 1.2rem;">
                                <span>Tổng cộng:</span>
                                <strong id="total" style="color: #667eea;">0 đ</strong>
                            </div>
                            <button class="btn btn-primary btn-lg w-100 mt-3" onclick="goToCheckout()">
                                <i class="fas fa-credit-card"></i> Thanh toán
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="alert alert-info alert-lg" role="alert">
                <i class="fas fa-shopping-cart"></i> Giỏ hàng của bạn đang trống
                <a href="@Url.Action("Index", "Product")" class="alert-link">Mua sắm ngay</a>
            </div>
        }
    </div>
</div>

<script>
    function updateQty(productId, newQty) {
        var qty = parseInt(newQty);
        if (qty <= 0) {
            removeFromCart(productId);
            return;
        }

        $.ajax({
            url: '@Url.Action("Update", "Cart")',
            method: 'POST',
            data: { productId: productId, quantity: qty },
            success: function (data) {
                if (data.success) {
                    location.reload();
                }
            }
        });
    }

    function removeFromCart(productId) {
        if (confirm('Xóa sản phẩm này khỏi giỏ?')) {
            $.ajax({
                url: '@Url.Action("Remove", "Cart")',
                method: 'POST',
                data: { productId: productId },
                success: function (data) {
                    if (data.success) {
                        location.reload();
                    }
                }
            });
        }
    }

    function goToCheckout() {
        window.location.href = '@Url.Action("Checkout", "Cart")';
    }

    $(document).ready(function () {
        calculateTotal();
    });

    function calculateTotal() {
        var subtotal = 0;
        
        // Tính tạm tính từ từng row
        $('#cartTableBody tr').each(function () {
            var price = parseFloat($(this).data('price'));
            var quantity = parseInt($(this).data('quantity'));
            
            if (!isNaN(price) && !isNaN(quantity)) {
                subtotal += price * quantity;
            }
        });

        var shipping = 30000;
        var discount = parseFloat($('#cartTableBody').data('discount')) || 0;
        var grandTotal = subtotal - discount + shipping;

        $('#subtotal').text(subtotal.toLocaleString('vi-VN') + ' đ');
        $('#discount').text(discount.toLocaleString('vi-VN') + ' đ');
        $('#total').text(Math.max(0, grandTotal).toLocaleString('vi-VN') + ' đ');
    }
</script>