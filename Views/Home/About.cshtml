@{
    ViewBag.Title = "Giới thiệu - TechWorld";
}

<div class="row mt-4">
    <div class="col-md-8 offset-md-2">
        <h1 class="mb-4">Về TechWorld</h1>

        <div style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; padding: 40px; border-radius: 8px; margin-bottom: 40px; text-align: center;">
            <h2 style="font-size: 2.5rem; margin-bottom: 20px;">
                <i class="fas fa-microchip"></i> TechWorld
            </h2>
            <p style="font-size: 1.2rem;">Website bán hàng công nghệ hàng đầu Việt Nam</p>
        </div>

        <h3>Sứ mạng của chúng tôi</h3>
        <p style="line-height: 1.8;">
            TechWorld là một nền tảng thương mại điện tử chuyên cung cấp các sản phẩm công nghệ chất lượng cao, 
            bao gồm điện thoại thông minh, laptop, máy tính bảng, linh kiện máy tính và các sản phẩm công nghệ khác.
        </p>

        <h3>Tại sao chọn TechWorld?</h3>
        <ul style="line-height: 2;">
            <li><strong><i class="fas fa-check" style="color: #667eea;"></i> Sản phẩm chính hãng</strong></li>
            <li><strong><i class="fas fa-check" style="color: #667eea;"></i> Giá cạnh tranh</strong></li>
            <li><strong><i class="fas fa-check" style="color: #667eea;"></i> Giao hàng nhanh</strong></li>
            <li><strong><i class="fas fa-check" style="color: #667eea;"></i> Hỗ trợ 24/7</strong></li>
        </ul>
    </div>
</div>