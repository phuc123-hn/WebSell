@model List<web1.Models.VoucherViewModel>

@{
    ViewBag.Title = "Voucher của bạn";
}

<div class="container mt-5 mb-5">
    <div class="row">
        <div class="col-md-12">
            <h2 class="mb-4" style="color: #667eea;">
                <i class="fas fa-gift"></i> Voucher Của Bạn
            </h2>

            @if (Model != null && Model.Count > 0)
            {
                <div class="row">
                    @foreach (var voucherVM in Model)
                    {
                        var voucher = voucherVM.Voucher;
                        var isUsed = voucherVM.IsUsed;
                        var isExpired = voucher.EndDate < DateTime.Now;
                        var daysLeft = (voucher.EndDate - DateTime.Now).Days;
                        var statusClass = isExpired ? "danger" : (daysLeft <= 3 ? "warning" : "success");

                        <div class="col-md-4 mb-4">
                            <div class="card @(isExpired ? "border-danger" : "border-success") position-relative">
                                <!-- Thanh Trạng Thái -->
                                <div style="position: absolute; top: 0; right: 0; left: 0; height: 4px; background: linear-gradient(90deg, @(isUsed ? "#dc3545" : "#28a745") 0%, @(isUsed ? "#dc3545" : "#28a745") 100%);"></div>

                                <div class="card-header @("bg-" + statusClass) text-white">
                                    <div style="display: flex; justify-content: space-between; align-items: center;">
                                        <h5 class="mb-0">@voucher.Name</h5>
                                        <!-- Badge Trạng Thái -->
                                        <span class="badge @(isUsed ? "bg-danger" : "bg-success")">
                                            @if (isUsed)
                                            {
                                                <text><i class="fas fa-check-circle"></i> Đã dùng</text>
                                            }
                                            else
                                            {
                                                <text><i class="fas fa-clock"></i> Chưa dùng</text>
                                            }
                                        </span>
                                    </div>
                                </div>

                                <!-- Thanh Progress -->
                                <div class="card-body">
                                    <div class="mb-3">
                                        <div style="font-size: 12px; margin-bottom: 5px;">
                                            <strong>Trạng thái:</strong> 
                                            @if (isUsed)
                                            {
                                                <span style="color: #dc3545;">✓ Đã ghi nhận - Sử dụng rồi</span>
                                            }
                                            else
                                            {
                                                <span style="color: #28a745;">○ Chưa ghi nhận - Còn có thể dùng</span>
                                            }
                                        </div>
                                        <div class="progress" style="height: 25px; background: #f0f0f0;">
                                            <div class="progress-bar @(isUsed ? "bg-danger" : "bg-success")" 
                                                 role="progressbar" 
                                                 style="width: @(isUsed ? "100%" : "0%"); display: flex; align-items: center; justify-content: center; font-weight: bold; color: white;">
                                                @if (isUsed)
                                                {
                                                    <text>Đã dùng</text>
                                                }
                                                else
                                                {
                                                    <text>Chờ sử dụng</text>
                                                }
                                            </div>
                                        </div>
                                    </div>

                                    <hr />

                                    <p class="card-text">
                                        <strong>Mã:</strong> <code style="background: #f5f5f5; padding: 5px;">@voucher.Code</code>
                                    </p>

                                    @if (voucher.DiscountPercent > 0)
                                    {
                                        <p class="card-text">
                                            <strong>Giảm:</strong> <span class="badge bg-success">-@voucher.DiscountPercent%</span>
                                        </p>
                                    }

                                    @if (voucher.DiscountAmount > 0)
                                    {
                                        <p class="card-text">
                                            <strong>Giảm:</strong> <span class="badge bg-success">-@voucher.DiscountAmount.ToString("N0")đ</span>
                                        </p>
                                    }

                                    @if (voucher.MinOrderAmount > 0)
                                    {
                                        <p class="card-text">
                                            <strong>Đơn tối thiểu:</strong> @voucher.MinOrderAmount.ToString("N0")đ
                                        </p>
                                    }

                                    <hr />

                                    <p class="card-text">
                                        <strong>Hạn sử dụng:</strong> @voucher.EndDate.ToString("dd/MM/yyyy")
                                    </p>

                                    @if (isExpired)
                                    {
                                        <div class="alert alert-danger mb-0">
                                            <i class="fas fa-times-circle"></i> Đã hết hạn
                                        </div>
                                    }
                                    else if (daysLeft <= 3)
                                    {
                                        <div class="alert alert-warning mb-0">
                                            <i class="fas fa-exclamation-triangle"></i> Còn @daysLeft ngày
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="alert alert-info mb-0">
                                            <i class="fas fa-check-circle"></i> Còn @daysLeft ngày
                                        </div>
                                    }

                                    <!-- Trạng Thái Sử Dụng Chi Tiết -->
                                    <div style="margin-top: 10px; padding: 10px; background: @(isUsed ? "#fff3cd" : "#d1ecf1"); border-left: 4px solid @(isUsed ? "#ff6b6b" : "#17a2b8"); border-radius: 4px;">
                                        @if (isUsed)
                                        {
                                            <div style="font-size: 13px; color: #856404;">
                                                <i class="fas fa-info-circle"></i>
                                                <strong>Voucher này đã được sử dụng</strong>
                                                <br />
                                                <small>Bạn đã áp dụng voucher này vào một đơn hàng.</small>
                                            </div>
                                        }
                                        else
                                        {
                                            <div style="font-size: 13px; color: #0c5460;">
                                                <i class="fas fa-check-circle"></i>
                                                <strong>Voucher này còn có thể sử dụng</strong>
                                                <br />
                                                <small>Bạn có thể áp dụng voucher này vào đơn hàng tiếp theo.</small>
                                            </div>
                                        }
                                    </div>
                                </div>

                                @if (!isExpired && voucher.IsActive && !isUsed)
                                {
                                    <div class="card-footer">
                                        <button class="btn btn-primary btn-sm w-100" onclick="copyVoucherCode('@voucher.Code')">
                                            <i class="fas fa-copy"></i> Sao chép mã
                                        </button>
                                    </div>
                                }
                                else if (isUsed)
                                {
                                    <div class="card-footer" style="background: #e9ecef;">
                                        <button class="btn btn-secondary btn-sm w-100" disabled>
                                            <i class="fas fa-check-circle"></i> Đã dùng
                                        </button>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="alert alert-info">
                    <p>Bạn chưa có voucher nào. <a href="@Url.Action("Events", "Voucher")">Tham gia sự kiện để nhận voucher</a></p>
                </div>
            }
        </div>
    </div>
</div>

<script>
    function copyVoucherCode(code) {
        // Copy to clipboard
        navigator.clipboard.writeText(code).then(function () {
            alert('Đã sao chép: ' + code);
        }).catch(function (err) {
            console.error('Error copying:', err);
        });
    }
</script>
