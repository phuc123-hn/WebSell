@model List<web1.Models.Order>

@{
    ViewBag.Title = "Đơn hàng của tôi - TechWorld";
}

<div class="container mt-5">
    <div class="row mb-4">
        <div class="col-md-8">
            <h2><i class="fas fa-box"></i> Đơn hàng của tôi</h2>
        </div>
        <div class="col-md-4 text-end">
            <a href="@Url.Action("MyAccount", "AccountProfile")" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> Quay lại
            </a>
        </div>
    </div>

    @if (Model != null && Model.Count > 0)
    {
        <div class="table-responsive">
            <table class="table table-hover table-bordered">
                <thead class="table-dark">
                    <tr>
                        <th style="width: 10%;">Mã đơn</th>
                        <th style="width: 15%;">Ngày đặt</th>
                        <th style="width: 15%;">Tổng tiền</th>
                        <th style="width: 15%;">Trạng thái</th>
                        <th style="width: 15%;">Thanh toán</th>
                        <th style="width: 15%;">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model)
                    {
                        string statusClass = "";
                        string statusText = "";

                        switch (order.Status)
                        {
                            case "Pending":
                                statusClass = "warning";
                                statusText = "Chờ xử lý";
                                break;
                            case "Processing":
                                statusClass = "info";
                                statusText = "Đang xử lý";
                                break;
                            case "Shipped":
                                statusClass = "primary";
                                statusText = "Đã gửi";
                                break;
                            case "Delivered":
                                statusClass = "success";
                                statusText = "Đã giao";
                                break;
                            case "Cancelled":
                                statusClass = "danger";
                                statusText = "Đã hủy";
                                break;
                        }

                        <tr>
                            <td><strong>#@order.Id</strong></td>
                            <td>@order.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                            <td><strong style="color: #667eea;">@order.TotalAmount.ToString("N0") đ</strong></td>
                            <td>
                                <span class="badge bg-@statusClass">@statusText</span>
                            </td>
                            <td>
                                @if (order.IsPaid)
                                {
                                    <span class="badge bg-success"><i class="fas fa-check"></i> Đã thanh toán</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning"><i class="fas fa-clock"></i> Chưa thanh toán</span>
                                }
                            </td>
                            <td>
                                <a href="@Url.Action("OrderDetails", "AccountProfile", new { id = order.Id })" class="btn btn-sm btn-info">
                                    <i class="fas fa-eye"></i> Xem chi tiết
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info" role="alert">
            <i class="fas fa-info-circle"></i>
            <strong>Bạn chưa có đơn hàng nào!</strong>
            <p class="mt-2">Hãy <a href="@Url.Action("Index", "Product")">tiếp tục mua sắm</a> để tạo đơn hàng đầu tiên.</p>
        </div>
    }

    <div class="mt-4">
        <a href="@Url.Action("Index", "Product")" class="btn btn-primary btn-lg">
            <i class="fas fa-shopping-bag"></i> Tiếp tục mua sắm
        </a>
        <a href="@Url.Action("Index", "Home")" class="btn btn-secondary btn-lg">
            <i class="fas fa-home"></i> Trang chủ
        </a>
    </div>
</div>

<style>
    table {
        background-color: white;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    }

    .table-hover tbody tr:hover {
        background-color: #f5f5f5;
    }

    .badge {
        padding: 8px 12px;
        font-size: 0.9rem;
    }

    .alert {
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    }
</style>