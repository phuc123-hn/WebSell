@model web1.Models.Product

@{
    ViewBag.Title = Model.Name + " - TechWorld";
}

<style>
    /* Đồng bộ nền tối cho trang chi tiết */
    body {
        background-color: #1a1d1a !important;
        color: #e0e0e0;
    }

    h1, h2, h3, h4, p, label {
        color: #e0e0e0 !important;
    }

    /* Style chung cho Icon Ngôi sao */
    .star-icon {
        font-size: 1.1rem;
        margin-right: 2px;
        filter: drop-shadow(0 0 2px rgba(255, 193, 7, 0.3));
    }

    .star-filled {
        color: #ffc107;
    }

    .star-empty {
        color: #444;
    }

    .detail-rating {
        display: flex;
        align-items: center;
        margin-bottom: 15px;
    }

    /* Card sản phẩm liên quan */
    .related-card {
        background-color: #121412;
        border: 1px solid #a2f6a2;
        border-radius: 8px;
        padding: 15px;
        margin-bottom: 20px;
        height: 100%;
        display: flex;
        flex-direction: column;
        transition: transform 0.2s, box-shadow 0.2s;
    }

        .related-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 0 15px rgba(162, 246, 162, 0.3);
        }

    .related-title {
        color: #a2f6a2;
        font-weight: bold;
        margin-top: 10px;
        font-size: 1.1rem;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
</style>

<div class="row mt-4">
    <div class="col-md-5">
        <div style="background: #000; border: 1px solid #444; border-radius: 8px; height: 400px; overflow: hidden; display: flex; align-items: center; justify-content: center; position: relative;">
            @if (Model.IsHot)
            {
                <span style="position: absolute; top: 15px; right: 15px; background: #ff4757; color: white; padding: 5px 15px; border-radius: 20px; font-weight: bold; z-index: 10; box-shadow: 0 0 10px rgba(255,71,87,0.5);">HOT</span>
            }

            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <img src="@Url.Content(Model.ImageUrl)" alt="@Model.Name" style="width: 100%; height: 100%; object-fit: contain; background: #000;" />
            }
            else
            {
                <i class="fas fa-image" style="font-size: 5rem; color: #333;"></i>
            }
        </div>
    </div>

    <div class="col-md-7">
        <h1 class="mb-2" style="color: #a2f6a2 !important;">@Model.Name</h1>

        @* RATING CHI TIẾT *@
        <div class="detail-rating">
            @for (int i = 1; i <= 5; i++)
            {
                if (i <= Math.Floor(Model.Rating))
                {
                    <i class="fas fa-star star-icon star-filled"></i>
                }
                else if (i == Math.Ceiling(Model.Rating) && Model.Rating % 1 != 0)
                {
                    <i class="fas fa-star-half-alt star-icon star-filled"></i>
                }
                else
                {
                    <i class="far fa-star star-icon star-empty"></i>
                }
            }
            <span style="color: #aaa; font-size: 1.1rem; margin-left: 10px;">(@Model.Rating / 5.0)</span>
        </div>

        <div style="margin-bottom: 20px;">
            <span class="badge" style="font-size: 0.9rem; background-color: #333 !important; border: 1.5px solid #a2f6a2; color: #a2f6a2; padding: 8px 15px;">
                <i class="fas fa-tag me-1"></i> Danh mục: @Model.Category.Name
            </span>
        </div>

        <div style="font-size: 2.2rem; color: #a2f6a2; font-family: 'Courier New', Courier, monospace; font-weight: bold; margin-bottom: 25px; letter-spacing: 1px;">
            @Model.Price.ToString("N0") VNĐ
        </div>

        <div style="margin-bottom: 25px;">
            <p><strong style="color: #a2f6a2;">Mô tả sản phẩm:</strong></p>
            <p style="color: #bbb; line-height: 1.6;">@Model.Description</p>
        </div>

        <div style="margin-bottom: 20px;">
            <p>
                <strong>Tình trạng:</strong>
                @if (Model.Stock > 0)
                {
                    <span class="badge bg-success" style="background-color: #28a745 !important; padding: 5px 10px;">Còn @Model.Stock sản phẩm</span>
                }
                else
                {
                    <span class="badge bg-danger" style="padding: 5px 10px;">Hết hàng</span>
                }
            </p>
        </div>

        <div style="margin-bottom: 30px;">
            <label class="form-label fw-bold">Số lượng:</label>
            <div class="input-group" style="width: 150px;">
                <button class="btn btn-outline-secondary" style="border-color: #666; color: #fff;" type="button" onclick="decreaseQty()">-</button>
                <input type="number" id="quantity" class="form-control text-center" style="background: #222; border-color: #666; color: #fff;" value="1" min="1" max="@Model.Stock">
                <button class="btn btn-outline-secondary" style="border-color: #666; color: #fff;" type="button" onclick="increaseQty()">+</button>
            </div>
        </div>

        <div>
            @if (Model.Stock > 0)
            {
                <button class="btn btn-lg px-5 py-3" style="background-color: #a2f6a2; color: #121412; font-weight: bold; border: none; transition: 0.3s;" onmouseover="this.style.backgroundColor='#fff'" onmouseout="this.style.backgroundColor='#a2f6a2'" onclick="addToCartWithQty(@Model.Id)">
                    <i class="fas fa-cart-plus me-2"></i> THÊM VÀO GIỎ HÀNG
                </button>
            }
            else
            {
                <button class="btn btn-secondary btn-lg px-5 py-3" disabled style="opacity: 0.5;">
                    <i class="fas fa-times me-2"></i> HẾT HÀNG
                </button>
            }
        </div>
    </div>
</div>

<hr class="my-5" style="border-color: #444;" />

@* PHẦN SẢN PHẨM LIÊN QUAN *@
<div class="row">
    <div class="col-12">
        <h3 style="margin-bottom: 25px; border-left: 5px solid #a2f6a2; padding-left: 15px; color: #a2f6a2 !important; text-transform: uppercase;">Sản phẩm liên quan</h3>
    </div>

    @if (ViewBag.RelatedProducts != null)
    {
        foreach (var product in ViewBag.RelatedProducts)
        {
            <div class="col-lg-3 col-md-4 col-sm-6 mb-4">
                <div class="related-card">
                    <div class="product-image" style="position: relative; height: 180px; margin-bottom: 10px; background: #000; border-radius: 4px;">
                        @if (!string.IsNullOrEmpty(product.ImageUrl))
                        {
                            <img src="@Url.Content(product.ImageUrl)" alt="@product.Name" style="width: 100%; height: 100%; object-fit: contain;" />
                        }
                        else
                        {
                            <div style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center;">
                                <i class="fas fa-laptop" style="font-size: 3rem; color: #222;"></i>
                            </div>
                        }

                        @if (product.IsHot)
                        {
                            <span style="position: absolute; top: 10px; right: 10px; background: #ff4757; color: white; padding: 4px 10px; border-radius: 20px; font-size: 0.7rem; font-weight: bold;">HOT</span>
                        }
                    </div>
                    <div class="product-info mt-auto">
                        <div class="related-title">@product.Name</div>

                        @* RATING TRONG CARD LIÊN QUAN *@
                        <div style="display: flex; align-items: center; margin: 8px 0;">
                            @for (int i = 1; i <= 5; i++)
                            {
                                if (i <= Math.Floor(product.Rating))
                                {
                                    <i class="fas fa-star" style="color: #ffc107; font-size: 0.75rem; margin-right: 2px;"></i>
                                }
                                else if (i == Math.Ceiling(product.Rating) && product.Rating % 1 != 0)
                                {
                                    <i class="fas fa-star-half-alt" style="color: #ffc107; font-size: 0.75rem; margin-right: 2px;"></i>
                                }
                                else
                                {
                                    <i class="far fa-star" style="color: #444; font-size: 0.75rem; margin-right: 2px;"></i>
                                }
                            }
                        </div>

                        <div style="color: #a2f6a2; font-family: 'Courier New', Courier, monospace; font-weight: bold; margin-bottom: 10px;">@product.Price.ToString("N0") đ</div>
                        <a href="@Url.Action("Details", "Product", new { id = product.Id })" class="btn btn-sm w-100" style="background-color: transparent; border: 1.5px solid #a2f6a2; color: #a2f6a2; font-weight: bold;">
                            CHI TIẾT
                        </a>
                    </div>
                </div>
            </div>
        }
    }
</div>

<script>
    function increaseQty() {
        var qty = document.getElementById('quantity');
        if (parseInt(qty.value) < @Model.Stock) {
            qty.value = parseInt(qty.value) + 1;
        }
    }

    function decreaseQty() {
        var qty = document.getElementById('quantity');
        if (parseInt(qty.value) > 1) {
            qty.value = parseInt(qty.value) - 1;
        }
    }

    function addToCartWithQty(productId) {
        var qty = parseInt(document.getElementById('quantity').value);
        if (typeof addToCart === "function") {
            addToCart(productId, qty);
        } else {
            alert("Đã thêm " + qty + " sản phẩm vào giỏ hàng!");
        }
    }
</script>