<body>

    <button class="back-btn" onclick="window.history.back()">← Quay lại</button>

    <div class="drag-hint" id="dragHint">
        <div class="drag-hint-icon"></div>
        Kéo để xoay
    </div>

    <div class="stage" id="stage">
        <canvas class="particles" id="cvs"></canvas>

        <div class="hero-text" id="heroText">
            <div class="hero-title">@Model.Name</div>
            <div class="hero-sub">Chi tiết kỹ thuật · Hiệu suất · Tính năng</div>
        </div>

        <div class="scene" id="scene">
            <!-- Device injected by JS -->
        </div>

        <div class="hint" id="hint">Chạm để khám phá</div>

        <div class="popup-overlay" id="popupOverlay">
            <div class="popup-card">
                <div class="popup-head">
                    <div class="popup-icon" id="popupIcon"></div>
                    <div class="popup-titles">
                        <div class="popup-name" id="popupName"></div>
                        <div class="popup-sub" id="popupSub"></div>
                    </div>
                    <div class="popup-close" id="popupClose">✕</div>
                </div>
                <div class="popup-body" id="popupBody"></div>
            </div>
        </div>
    </div>

    <script>
const PRODUCT_ID   = @Model.Id;
const PRODUCT_NAME = '@Html.Raw(Model.Name.Replace("'", "\\'"))';
const DEVICE_TYPE  = '@deviceType';

const DIM = {
    phone:   { w: 220, h: 440 },
    ipad:    { w: 320, h: 430 },
    macbook: { w: 480, h: 310 },
    laptop:  { w: 460, h: 300 },
};

function buildDeviceHTML(type, name) {
    const short = name.split(' ').slice(0,2).join(' ');
    const cat   = name.split(' ')[0];

    if (type === 'phone') return `
      <div class="${type}-wrap" id="deviceWrap">
        <div class="layer l-glow-${type}"></div>
        <div class="layer l-shadow-${type}" id="lShadow"></div>
        <div class="layer l-spena-${type}" id="lSpena">
          <div class="sp-d"></div><div class="sp-d"></div><div class="sp-d"></div><div class="sp-d"></div><div class="sp-d"></div>
        </div>
        <div class="layer l-frame-${type}" id="lFrame">
          <div class="frame-inner-p">
            <div class="frame-hl"></div><div class="frame-hr"></div>
            <div class="btn-v1"></div><div class="btn-v2"></div><div class="btn-pw"></div>
            <div class="notch-bar"><div class="notch-dot"></div></div>
          </div>
        </div>
        <div class="layer l-screen-${type}" id="lScreen">
          <div class="screen-bg-p">
            <div class="sbar"><span class="stime">9:41</span><div class="sicons"><div class="sb" style="height:8px;background:rgba(255,255,255,.8)"></div><div class="sb" style="height:6px;background:rgba(255,255,255,.55)"></div><div class="sb" style="height:4px;background:rgba(255,255,255,.35)"></div></div></div>
            <div class="wp-area"><div class="wp"><div class="wp-c1"></div><div class="wp-c2"></div><div class="wp-t">${name.split(' ').slice(0,2).join('<br>')}</div><div class="wp-s">${cat}</div></div></div>
            <div class="dock"><div class="di" style="background:rgba(30,90,220,.5)"><div class="dd"></div></div><div class="di" style="background:rgba(20,180,120,.4)"><div class="dd"></div></div><div class="di" style="background:rgba(200,60,60,.4)"><div class="dd"></div></div><div class="di" style="background:rgba(180,120,20,.4)"><div class="dd"></div></div></div>
          </div>
        </div>
        <div class="layer l-camera-${type}" id="lCamera"><div class="cam-row"><div class="cam-lens"><div class="cam-li"></div></div><div style="display:flex;flex-direction:column;gap:3px"><div class="cam-mini"></div><div class="cam-mini"></div></div></div><div class="cam-lbl">CAM · ZOOM</div></div>
        <div class="layer l-chip" id="lChip"><div class="chip-lbl">PROCESSOR</div><div class="chip-sub">AI ENGINE</div></div>
        <div class="layer l-battery" id="lBattery"><div class="batt-fill" style="width:32px"></div><div class="batt-lbl">BATTERY</div></div>
        <div class="layer l-ram" id="lRam"><div class="ram-lbl">RAM</div></div>
        <div class="layer l-display" id="lDisplay"><div class="disp-lbl">DISPLAY</div></div>
        <div class="layer l-wifi" id="lWifi"><div class="wifi-lbl">5G · WiFi</div></div>
      </div>`;

    if (type === 'ipad') return `
      <div class="${type}-wrap" id="deviceWrap">
        <div class="layer l-glow-${type}"></div>
        <div class="layer l-shadow-${type}" id="lShadow"></div>
        <div class="layer l-frame-${type}" id="lFrame"><div class="frame-inner-i"><div class="ipad-btn-pw"></div><div class="ipad-btn-vol1"></div><div class="ipad-btn-vol2"></div><div class="ipad-front-cam"></div><div class="ipad-home-btn"></div></div></div>
