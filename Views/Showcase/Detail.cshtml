        }

        .l-chip {
            width: 78px;
            height: 30px;
            top: 195px;
            left: 71px;
            background: linear-gradient(135deg,#181c26,#0e1018);
            border-radius: 6px;
            border: .5px solid rgba(255,255,255,.09);
            display: flex;
            flex-direction: column;
