        <div class="layer l-camera-i" id="lCamera"><div class="cam-lens" style="width:30px;height:30px"><div class="cam-li" style="width:14px;height:14px"></div></div><div class="cam-lbl">CAMERA</div></div>
        <div class="layer l-chip-i" id="lChip"><div class="chip-lbl">CHIP APPLE</div><div class="chip-sub">NEURAL ENGINE</div></div>
        <div class="layer l-battery-i" id="lBattery"><div class="batt-fill" style="width:36px"></div><div class="batt-lbl">BATTERY</div></div>
        <div class="layer l-ram-i" id="lRam"><div class="ram-lbl">RAM</div></div>
        <div class="layer l-display-i" id="lDisplay"><div class="disp-lbl">DISPLAY</div></div>
        <div class="layer l-wifi-i" id="lWifi"><div class="wifi-lbl">WiFi · 5G</div></div>
      </div>`;

    if (type === 'macbook') return `
      <div class="${type}-wrap" id="deviceWrap">
        <div class="layer l-glow-${type}"></div>
        <div class="layer l-shadow-${type}" id="lShadow"></div>
        <div class="layer l-lid-${type}" id="lLid"><div class="lid-inner-mac"><div class="mac-screen"><div class="mac-menubar"><div class="mac-dot mac-dot-r"></div><div class="mac-dot mac-dot-y"></div><div class="mac-dot mac-dot-g"></div><div class="mac-menubar-label">${short}</div></div><div class="mac-desktop"><div class="mac-desktop-t">${short}</div><div class="mac-desktop-s">${cat}</div></div><div class="mac-dock-row"><div class="mac-dock-icon" style="background:rgba(30,120,255,.5)"></div><div class="mac-dock-icon" style="background:rgba(20,180,80,.4)"></div><div class="mac-dock-icon" style="background:rgba(200,60,60,.4)"></div><div class="mac-dock-icon" style="background:rgba(255,180,20,.4)"></div><div class="mac-dock-icon" style="background:rgba(120,80,200,.4)"></div></div></div><div class="mac-cam-notch"><div class="mac-cam-dot"></div></div></div></div>
        <div class="layer l-base-mac" id="lBase"></div>
        <div class="layer l-keyboard-mac" id="lKeyboard"><div class="mac-key-row">${[20,16,16,20,16,16,16,16,16,20].map(w=>`<div class="mac-key" style="width:${w}px"></div>`).join('')}</div><div class="mac-key-row">${[24,14,14,14,14,14,14,14,14,14,14,24].map(w=>`<div class="mac-key" style="width:${w}px"></div>`).join('')}</div><div class="mac-key-row">${[30,14,14,14,14,14,14,14,14,14,30].map(w=>`<div class="mac-key" style="width:${w}px"></div>`).join('')}</div><div class="mac-key-row" style="justify-content:center"><div class="mac-key" style="width:120px"></div></div></div>
        <div class="layer l-chip-mac" id="lChip"><div class="chip-lbl">APPLE SILICON</div><div class="chip-sub">NEURAL ENGINE</div></div>
        <div class="layer l-battery-mac" id="lBattery"><div class="batt-fill" style="width:42px"></div><div class="batt-lbl">BATTERY</div></div>
        <div class="layer l-ram-mac" id="lRam"><div class="ram-lbl">UNIFIED RAM</div></div>
        <div class="layer l-display-mac" id="lDisplay"><div class="disp-lbl">RETINA DSP</div></div>
        <div class="layer l-wifi-mac" id="lWifi"><div class="wifi-lbl">WiFi 6E · BT</div></div>
      </div>`;

    return `
    <div class="${type}-wrap" id="deviceWrap">
      <div class="layer l-glow-${type}"></div>
      <div class="layer l-shadow-${type}" id="lShadow"></div>
      <div class="layer l-lid-${type}" id="lLid"><div class="lid-inner-laptop"><div class="lt-screen"><div class="lt-menubar"><div class="mac-dot mac-dot-r"></div><div class="mac-dot mac-dot-y"></div><div class="mac-dot mac-dot-g"></div><div class="lt-menubar-label">${short}</div></div><div class="lt-desktop"><div class="lt-desktop-t">${short}</div><div class="lt-desktop-s">${cat}</div></div><div class="lt-taskbar"><div class="lt-task-icon" style="background:rgba(255,255,255,.2)"></div><div class="lt-task-icon" style="background:rgba(30,120,255,.5)"></div><div class="lt-task-icon" style="background:rgba(20,180,80,.4)"></div><div class="lt-task-icon" style="background:rgba(200,60,60,.4)"></div></div></div><div class="lt-cam-dot"></div></div></div>
      <div class="layer l-base-laptop" id="lBase"></div>
      <div class="layer l-chip-lt" id="lChip"><div class="chip-lbl">PROCESSOR</div><div class="chip-sub">AI ENGINE</div></div>
      <div class="layer l-battery-lt" id="lBattery"><div class="batt-fill" style="width:40px"></div><div class="batt-lbl">BATTERY</div></div>
      <div class="layer l-ram-lt" id="lRam"><div class="ram-lbl">RAM DDR5</div></div>
      <div class="layer l-display-lt" id="lDisplay"><div class="disp-lbl">DISPLAY</div></div>
      <div class="layer l-wifi-lt" id="lWifi"><div class="wifi-lbl">WiFi 6E · BT</div></div>
    </div>`;
}

