@model web1.Models.Product

@{
    Layout = null;
    ViewBag.Title = "Trưng Bày 3D - " + Model.Name;

    string nameLower = Model.Name.ToLower();
    string deviceType = "phone";
    if (nameLower.Contains("macbook") || nameLower.Contains("mac book")) { deviceType = "macbook"; }
    else if (nameLower.Contains("ipad")) { deviceType = "ipad"; }
    else if (nameLower.Contains("laptop")) { deviceType = "laptop"; }
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            background: #03050a;
            overflow: hidden;
            color: #fff;
        }

        .stage {
            width: 100vw;
            height: 100vh;
            background: #03050a;
            background-image: radial-gradient(circle at 25% 35%, rgba(80,120,255,.07) 0%, transparent 60%), radial-gradient(circle at 75% 65%, rgba(80,200,255,.05) 0%, transparent 65%);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            position: relative;
            user-select: none;
        }

        /* cursor changes based on drag state */
        .stage {
            cursor: grab;
        }

            .stage.dragging {
                cursor: grabbing;
            }

            .stage::before {
                content: '';
                position: absolute;
                inset: 0;
                background: radial-gradient(white 1.2px, transparent 1px), radial-gradient(#a0f0ff 1px, transparent 1px), radial-gradient(#d0a0ff 1.5px, transparent 1px);
                background-size: 90px 90px, 140px 140px, 200px 200px;
                background-position: 0 0, 30px 50px, 70px 20px;
                opacity: 0;
                animation: twinkle 6s infinite alternate ease-in-out;
                pointer-events: none;
            }

        @@keyframes twinkle {
            0% {
                opacity: .45
            }

            100% {
                opacity: .85
            }
        }

        canvas.particles {
            position: absolute;
            inset: 0;
            pointer-events: none;
        }

        .back-btn {
            position: absolute;
            top: 20px;
            left: 20px;
            padding: 9px 18px;
            background: rgba(255,255,255,.07);
            color: rgba(255,255,255,.7);
            border: .5px solid rgba(255,255,255,.14);
            border-radius: 20px;
            cursor: pointer;
            font-size: 12px;
            z-index: 100;
            letter-spacing: .04em;
            transition: all .2s;
        }

            .back-btn:hover {
                background: rgba(255,255,255,.13);
                color: #fff;
            }

        /* drag hint badge */
        .drag-hint {
            position: absolute;
            top: 20px;
            right: 20px;
            padding: 7px 14px;
            background: rgba(255,255,255,.06);
            color: rgba(255,255,255,.38);
            border: .5px solid rgba(255,255,255,.1);
            border-radius: 20px;
            font-size: 11px;
            letter-spacing: .08em;
            z-index: 100;
            pointer-events: none;
            display: flex;
            align-items: center;
            gap: 6px;
            opacity: 0;
            transition: opacity .6s;
        }

            .drag-hint.visible {
                opacity: 1;
            }

        .drag-hint-icon {
            width: 14px;
            height: 14px;
            border: 1.5px solid rgba(255,255,255,.4);
            border-radius: 50%;
            position: relative;
            flex-shrink: 0;
        }

            .drag-hint-icon::after {
                content: '';
                position: absolute;
                left: 50%;
                top: 50%;
                transform: translate(-50%,-60%);
                width: 3px;
                height: 5px;
                border-radius: 2px;
                background: rgba(255,255,255,.4);
            }

        .hero-text {
            position: absolute;
            top: 44px;
            left: 50%;
            transform: translateX(-50%);
            text-align: center;
            z-index: 2;
            opacity: 0;
            transition: opacity .8s ease;
            white-space: nowrap;
            pointer-events: none;
        }

        .hero-title {
            font-size: 26px;
            font-weight: 500;
            color: #fff;
        }

        .hero-sub {
            font-size: 12px;
            color: rgba(100,150,255,.7);
            letter-spacing: .14em;
            text-transform: uppercase;
            margin-top: 5px;
        }

        .hint {
            position: absolute;
            bottom: 28px;
            left: 50%;
            transform: translateX(-50%);
            font-size: 11px;
            letter-spacing: .14em;
            color: rgba(255,255,255,.28);
            text-transform: uppercase;
            white-space: nowrap;
            z-index: 10;
            transition: opacity .4s;
        }

        .scene {
            perspective: 1200px;
            perspective-origin: 50% 45%;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            z-index: 2;
        }

        .layer {
            position: absolute;
            transform-style: preserve-3d;
            transition: transform 1s cubic-bezier(.23,1,.32,1), opacity .8s ease;
        }

        /* ── PHONE ── */
        .phone-wrap {
            transform-style: preserve-3d;
            position: relative;
            width: 220px;
            height: 440px;
            transition: transform 1.2s cubic-bezier(.23,1,.32,1);
        }

        .l-glow-phone {
            width: 220px;
            height: 440px;
            border-radius: 44px;
            background: radial-gradient(ellipse at 50% 50%,rgba(100,140,255,.15) 0%,transparent 70%);
            top: 0;
            left: 0;
            transform: translateZ(-10px) scale(1.18);
            pointer-events: none;
        }

        .l-shadow-phone {
            width: 160px;
            height: 26px;
            border-radius: 50%;
            background: rgba(0,0,0,.75);
            bottom: -58px;
            left: 30px;
            top: auto;
        }

        .l-frame-phone {
            width: 220px;
            height: 440px;
            border-radius: 44px;
            top: 0;
            left: 0;
            overflow: hidden;
        }

        .frame-inner-p {
            width: 100%;
            height: 100%;
            background: linear-gradient(165deg,#2c2f38 0%,#1c1e25 40%,#0f1015 100%);
            border-radius: 44px;
            border: 1.5px solid rgba(255,255,255,.12);
            position: relative;
        }

            .frame-inner-p::before {
                content: '';
                position: absolute;
                inset: 0;
                border-radius: 44px;
                background: linear-gradient(#1c1e25,#1c1e25) padding-box,linear-gradient(135deg,rgba(255,255,255,.22),rgba(255,255,255,.02),rgba(255,255,255,.18)) border-box;
                border: 2px solid transparent;
            }

        .frame-hl {
            position: absolute;
            left: 0;
            top: 60px;
            bottom: 60px;
            width: 3px;
            background: linear-gradient(180deg,transparent,rgba(255,255,255,.09),transparent);
        }

        .frame-hr {
            position: absolute;
            right: 0;
            top: 60px;
            bottom: 60px;
            width: 3px;
            background: linear-gradient(180deg,transparent,rgba(255,255,255,.06),transparent);
        }

        .btn-v1 {
            position: absolute;
            left: -4px;
            top: 100px;
            width: 3px;
            height: 28px;
            background: #191b20;
            border-radius: 2px 0 0 2px;
        }

        .btn-v2 {
            position: absolute;
            left: -4px;
            top: 136px;
            width: 3px;
            height: 28px;
            background: #191b20;
            border-radius: 2px 0 0 2px;
        }

        .btn-pw {
            position: absolute;
            right: -4px;
