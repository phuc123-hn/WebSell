function getLayerZValues(type, exploded) {
    const e = exploded;
    if (type === 'phone') return { lShadow:e?-88:-28, lSpena:e?16:7, lFrame:e?52:20, lScreen:e?118:48, lCamera:e?208:88, lChip:e?168:72, lBattery:e?188:82, lRam:e?172:78, lDisplay:e?130:52, lWifi:e?158:68 };
    if (type === 'ipad')  return { lShadow:e?-80:-24, lFrame:e?44:16, lScreen:e?100:40, lCamera:e?170:70, lChip:e?140:58, lBattery:e?156:64, lRam:e?144:60, lDisplay:e?110:44, lWifi:e?132:54 };
    if (type === 'macbook') return { lShadow:e?-70:-20, lLid:e?90:30, lBase:e?-20:-4, lKeyboard:e?50:16, lChip:e?130:52, lBattery:e?110:44, lRam:e?120:48, lDisplay:e?140:58, lWifi:e?100:40 };
    return { lShadow:e?-65:-18, lLid:e?84:28, lBase:e?-18:-4, lChip:e?120:48, lBattery:e?100:40, lRam:e?110:44, lDisplay:e?128:52, lWifi:e?90:36 };
}

/* ── INIT DOM ── */
const scene = document.getElementById('scene');
scene.innerHTML = buildDeviceHTML(DEVICE_TYPE, PRODUCT_NAME);

const tagsConfig = getTagsConfig(DEVICE_TYPE);
const deviceWrapEl = document.getElementById('deviceWrap');

tagsConfig.forEach(t => {
    const div = document.createElement('div');
    div.className = 'comp-tag';
    div.id = 'tag-' + t.id;
    div.style.cssText = t.style;
    if (t.dir === 'left') div.style.flexDirection = 'row-reverse';
    div.innerHTML = `<div class="tag-line" style="width:30px"></div>
                     <div class="tag-pill ${t.cls}" data-comp="${t.id}">${t.label}</div>`;
    deviceWrapEl.appendChild(div);
});

/* ── SPECS ── */
let specsData = null;
fetch(`/Showcase/GetProductSpecs?id=${PRODUCT_ID}`)
    .then(r => r.json())
    .then(d => { specsData = d.specs; })
    .catch(e => console.error('Specs error:', e));

/* ──────────────────────────────────────────────────
   ROTATION STATE
   All rotation lives in curRX / curRY.
   targetRX / targetRY is the "destination" for lerp.
   In drag mode we update both simultaneously for 1:1 feel.
   Inertia: on mouseup/touchend we carry over the velocity.
────────────────────────────────────────────────── */
let phase     = 0;
let autoAngle = 0;
let curRX = 12,  curRY = -18;
let targetRX = 12, targetRY = -18;

/* drag state */
let isDragging = false;
let lastMouseX = 0, lastMouseY = 0;
let velX = 0, velY = 0;          // velocity in deg/px accumulated
let prevMouseX = 0, prevMouseY = 0;

/* limits (clamped more tightly in phase 2 so layers stay visible) */
const CLAMP_RX_MIN = -55, CLAMP_RX_MAX = 55;
const CLAMP_RY_MIN = -75, CLAMP_RY_MAX = 75;

let popupOpen = false;
const hint     = document.getElementById('hint');
const heroText = document.getElementById('heroText');
const overlay  = document.getElementById('popupOverlay');
const stageEl  = document.getElementById('stage');
const dragHint = document.getElementById('dragHint');

function lerp(a, b, t) { return a + (b - a) * t; }
function clamp(v, lo, hi) { return Math.max(lo, Math.min(hi, v)); }

function setLayerZ(id, z, delay) {
    const el = document.getElementById(id);
    if (!el) return;
    el.style.transition = `transform ${1.0 + delay*.1}s cubic-bezier(.23,1,.32,1) ${delay}s, opacity .8s ${delay}s`;
    el.style.transform  = `translateZ(${z}px)`;
}

function applyZValues(exploded) {
    const zv  = getLayerZValues(DEVICE_TYPE, exploded);
    const del = { lShadow:0, lBase:0, lKeyboard:.04, lFrame:.06, lLid:.08, lSpena:.04, lScreen:.12, lDisplay:.13, lCamera:.16, lChip:.18, lBattery:.20, lRam:.22, lWifi:.26 };
    let i = 0;
    for (const [id, z] of Object.entries(zv)) { setLayerZ(id, z, del[id] ?? (i * .04)); i++; }
}

function showTags(show) {
    tagsConfig.forEach(t => {
        const el = document.getElementById('tag-' + t.id);
        if (el) { el.style.opacity = show ? '1' : '0'; el.style.pointerEvents = show ? 'all' : 'none'; }
    });
}

function flatMode() {
    deviceWrapEl.querySelectorAll('.layer').forEach(l => { l.style.transform = 'translateZ(0px)'; });
    showTags(false);
}

function applyRotation() {
    deviceWrapEl.style.transform = `rotateX(${curRX.toFixed(2)}deg) rotateY(${curRY.toFixed(2)}deg)`;
}

function phase1Mode() {
    heroText.style.opacity = '1';
    hint.textContent = 'Nhấn để tách rời linh kiện · Kéo để xoay';
    applyZValues(false);
    dragHint.classList.add('visible');
}

function phase2Mode() {
    hint.textContent = 'Kéo để xoay · Click tên linh kiện để xem thông số';
    /* snap to a nice exploded view angle */
    targetRX = 16; targetRY = -18;
    curRX = 16;    curRY = -18;
    applyZValues(true);
    setTimeout(() => showTags(true), 900);
}

/* ── CLICK (phase advance, not fired during drag) ── */
let wasDragging = false;
stageEl.addEventListener('click', e => {
    if (popupOpen) return;
    if (wasDragging) { wasDragging = false; return; }   // swallowed by drag
    if (phase === 2 && e.target.closest('[data-comp]')) return;
    phase++;
    if (phase === 1) phase1Mode();
    else if (phase === 2) phase2Mode();
    else {
        phase = 0;
        hint.textContent = 'Chạm để khám phá';
        heroText.style.opacity = '0';
        showTags(false);
        flatMode();
        targetRX = 12; targetRY = -18;
        dragHint.classList.remove('visible');
    }
});

/* ────────────────────────────────────────
   MOUSE DRAG (works in all phases)
──────────────────────────────────────── */
const DRAG_SENS_X = 0.35;   // drag speed for rotateX (vertical drag)
const DRAG_SENS_Y = 0.55;   // drag speed for rotateY (horizontal drag)
const INERTIA     = 0.88;   // velocity decay per frame (higher = slides longer)
const HOVER_SENS  = 0.5;    // hover (non-drag) sensitivity scale

stageEl.addEventListener('mousedown', e => {
    if (popupOpen) return;
    if (phase === 0) return;   // let auto-rotation handle phase 0, feels nicer
    isDragging  = true;
    wasDragging = false;
    lastMouseX  = e.clientX;
    lastMouseY  = e.clientY;
    prevMouseX  = e.clientX;
    prevMouseY  = e.clientY;
    velX = velY = 0;
    stageEl.classList.add('dragging');
    e.preventDefault();
});

window.addEventListener('mousemove', e => {
    if (!isDragging) {
        /* hover parallax in phase 0 and 1 only */
        if (phase >= 2 || popupOpen) return;
        const r = stageEl.getBoundingClientRect();
        targetRX = 12 - ((e.clientY - r.top)  / r.height - .5) * 20 * HOVER_SENS;
        targetRY = -18 + ((e.clientX - r.left) / r.width  - .5) * 30 * HOVER_SENS;
        return;
    }

    const dx = e.clientX - lastMouseX;
    const dy = e.clientY - lastMouseY;
    if (Math.abs(dx) > 2 || Math.abs(dy) > 2) wasDragging = true;

    /* immediate response — move curRX/curRY directly */
    curRY = clamp(curRY + dx * DRAG_SENS_Y, CLAMP_RY_MIN, CLAMP_RY_MAX);
    curRX = clamp(curRX - dy * DRAG_SENS_X, CLAMP_RX_MIN, CLAMP_RX_MAX);
    targetRX = curRX;
    targetRY = curRY;

    /* track velocity for inertia (use short interval delta) */
    velX = (e.clientX - prevMouseX) * DRAG_SENS_Y * 0.6;
    velY = (e.clientY - prevMouseY) * DRAG_SENS_X * 0.6;
    prevMouseX = e.clientX;
    prevMouseY = e.clientY;
    lastMouseX = e.clientX;
    lastMouseY = e.clientY;
});

window.addEventListener('mouseup', () => {
    if (!isDragging) return;
    isDragging = false;
    stageEl.classList.remove('dragging');
    /* apply inertia by nudging target */
    targetRY = clamp(curRY + velX * 4, CLAMP_RY_MIN, CLAMP_RY_MAX);
    targetRX = clamp(curRX - velY * 4, CLAMP_RX_MIN, CLAMP_RX_MAX);
});

/* ────────────────────────────────────────
   TOUCH DRAG
──────────────────────────────────────── */
let touchStartX = 0, touchStartY = 0;
let touchLastX = 0,  touchLastY = 0;
let touchVelX = 0,   touchVelY = 0;
let touchMoved = false;

stageEl.addEventListener('touchstart', e => {
    const t = e.touches[0];
    touchStartX = t.clientX; touchStartY = t.clientY;
    touchLastX  = t.clientX; touchLastY  = t.clientY;
    touchMoved  = false;
    velX = velY = touchVelX = touchVelY = 0;
}, { passive: true });

stageEl.addEventListener('touchmove', e => {
    const t = e.touches[0];
    const dx = t.clientX - touchLastX;
    const dy = t.clientY - touchLastY;

    if (Math.abs(t.clientX - touchStartX) > 5 || Math.abs(t.clientY - touchStartY) > 5) touchMoved = true;

    if (phase >= 1) {
        curRY = clamp(curRY + dx * DRAG_SENS_Y, CLAMP_RY_MIN, CLAMP_RY_MAX);
        curRX = clamp(curRX - dy * DRAG_SENS_X, CLAMP_RX_MIN, CLAMP_RX_MAX);
        targetRX = curRX; targetRY = curRY;
        touchVelX = dx * DRAG_SENS_Y * 0.6;
        touchVelY = dy * DRAG_SENS_X * 0.6;
    }

    touchLastX = t.clientX; touchLastY = t.clientY;
}, { passive: true });

stageEl.addEventListener('touchend', e => {
    if (touchMoved) {
        targetRY = clamp(curRY + touchVelX * 4, CLAMP_RY_MIN, CLAMP_RY_MAX);
        targetRX = clamp(curRX - touchVelY * 4, CLAMP_RX_MIN, CLAMP_RX_MAX);
        /* prevent the touchend from firing a click */
        wasDragging = true;
        setTimeout(() => { wasDragging = false; }, 300);
    }
});

/* ────────────────────────────────────────
   ANIMATION LOOP
──────────────────────────────────────── */
(function tick() {
    autoAngle += .005;

    if (!isDragging) {
        if (phase === 0) {
            /* gentle auto-bob */
            targetRX = 12 + Math.cos(autoAngle * .7) * 4;
            targetRY = -18 + Math.sin(autoAngle) * 12;
        }
        /* lerp toward target (handles hover, inertia settle, phase snap) */
        const lerpSpeed = isDragging ? 1 : 0.06;
        curRX = lerp(curRX, targetRX, lerpSpeed);
        curRY = lerp(curRY, targetRY, lerpSpeed);
    }

    applyRotation();
    requestAnimationFrame(tick);
})();

/* ── TAG CLICKS → POPUP ── */
tagsConfig.forEach(t => {
    setTimeout(() => {
        const pill = deviceWrapEl.querySelector(`[data-comp="${t.id}"]`);
        if (pill) pill.addEventListener('click', e => {
            if (phase < 2) return;
            e.stopPropagation();
            openPopup(t.id);
        });
    }, 100);
});

function openPopup(key) {
    if (!specsData || !specsData[key]) {
        document.getElementById('popupName').textContent = key;
        document.getElementById('popupSub').textContent  = 'Đang tải...';
        document.getElementById('popupBody').innerHTML   = '<p style="color:rgba(255,255,255,.5);font-size:13px">Đang tải thông số kỹ thuật...</p>';
        overlay.classList.add('open');
        popupOpen = true;
        return;
    }
    const d = specsData[key];
    popupOpen = true;

    const icon = document.getElementById('popupIcon');
    icon.style.background = d.iconBg    || 'rgba(40,50,80,.9)';
    icon.style.color      = d.iconColor || 'rgba(200,210,255,.9)';
    icon.style.fontSize   = '10px';
    icon.style.fontWeight = '600';
    icon.textContent = d.iconSymbol || key.toUpperCase().slice(0,3);

    document.getElementById('popupName').textContent = d.name || key;
    document.getElementById('popupSub').textContent  = d.sub  || '';

    const body = document.getElementById('popupBody');
    body.innerHTML = '';

    (d.sections || []).forEach((s, i) => {
        if (i > 0) { const dv = document.createElement('div'); dv.className = 'divider'; body.appendChild(dv); }
        const row = document.createElement('div'); row.className = 'spec-row';
        let html = `<div class="spec-label">${s.label}</div><div class="spec-val">${(s.val||'').replace(/\n/g,'<br>')}</div>`;
        if (s.bar !== undefined)
            html += `<div class="spec-bar-wrap"><div class="spec-bar-fill" style="width:0%;background:${s.barColor||'#4488ff'}" data-w="${s.bar}"></div></div>`;
        if (s.tags)
            html += `<div class="spec-tags">${s.tags.map(t=>`<span class="spec-tag" style="color:${d.iconColor};border-color:rgba(255,255,255,.12);background:${(d.iconBg||'rgba(30,40,80,.7)').replace('.85','.4')}">${t}</span>`).join('')}</div>`;
        row.innerHTML = html;
        body.appendChild(row);
    });

    overlay.classList.add('open');
    setTimeout(() => {
        body.querySelectorAll('.spec-bar-fill').forEach(el => { el.style.width = el.dataset.w + '%'; });
    }, 380);
}

function closePopup() {
    popupOpen = false;
    overlay.classList.remove('open');
}

document.getElementById('popupClose').addEventListener('click', e => { e.stopPropagation(); closePopup(); });
overlay.addEventListener('click', e => { if (e.target === overlay) closePopup(); });

/* ── PARTICLES ── */
const cvs = document.getElementById('cvs');
const ctx = cvs.getContext('2d');
let pts = [];
function initPts() {
    cvs.width = cvs.offsetWidth; cvs.height = cvs.offsetHeight;
    pts = Array.from({ length: 80 }, () => ({
        x: Math.random() * cvs.width, y: Math.random() * cvs.height,
        vx: (Math.random()-.5)*.3, vy: (Math.random()-.5)*.3,
        r: Math.random()*1.6+.3, op: Math.random()*.35+.04,
    }));
}
(function drawPts() {
    ctx.clearRect(0, 0, cvs.width, cvs.height);
    pts.forEach(p => {
        p.x += p.vx; p.y += p.vy;
        if (p.x < 0 || p.x > cvs.width)  p.vx *= -1;
        if (p.y < 0 || p.y > cvs.height) p.vy *= -1;
        ctx.beginPath(); ctx.arc(p.x, p.y, p.r, 0, Math.PI*2);
        ctx.fillStyle = `rgba(100,150,255,${p.op})`; ctx.fill();
    });
    requestAnimationFrame(drawPts);
})();
initPts();
window.addEventListener('resize', initPts);

setTimeout(flatMode, 100);
    </script>
</body>
</html>
